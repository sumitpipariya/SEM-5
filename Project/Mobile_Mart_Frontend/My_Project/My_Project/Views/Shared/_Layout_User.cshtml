@* _Layout_User.cshtml *@
<!DOCTYPE html>
<html lang="en" id="theme-root">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Mobile Mart</title>

    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --primary: #2874f0;
            --primary-dark: #1a5dc6;
            --accent: #fb641b;
            --accent-hover: #e55300;
            --light-bg: #f8f9fa;
            --card-bg: #ffffff;
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --border-light: #e9ecef;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-md: 0 8px 24px rgba(0,0,0,0.1);
            --shadow-lg: 0 16px 40px rgba(40, 116, 240, 0.15);
            --header-height: 72px;
            --nav-height: 56px;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --transition-fast: 0.2s ease;
            --transition-normal: 0.3s ease;
        }

        [data-theme="dark"] {
            --light-bg: #121212;
            --card-bg: #1e1e1e;
            --text-primary: #f8f9fa;
            --text-secondary: #adb5bd;
            --border-light: #333;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.3);
            --shadow-md: 0 8px 24px rgba(0,0,0,0.4);
        }

        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: var(--light-bg);
            color: var(--text-primary);
            margin: 0;
            line-height: 1.6;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Top Header */
        #top-header {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            height: var(--header-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1050;
            box-shadow: var(--shadow-sm);
            transition: box-shadow var(--transition-normal);
        }

        [data-theme="dark"] #top-header {
            background: rgba(30, 30, 30, 0.9);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        #top-header:hover {
            box-shadow: var(--shadow-md);
        }

        .logo {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            letter-spacing: -0.5px;
            transition: transform var(--transition-fast);
        }

            .logo:hover {
                transform: scale(1.03);
            }

        .search-bar {
            flex: 1;
            max-width: 720px;
            margin: 0 1.5rem;
            position: relative;
        }

        .search-bar-inner {
            display: flex;
            background: var(--card-bg);
            border-radius: 50px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            overflow: hidden;
            transition: box-shadow var(--transition-normal);
        }

        [data-theme="dark"] .search-bar-inner {
            box-shadow: 0 2px 12px rgba(0,0,0,0.3);
        }

        .search-bar-inner:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
        }

        .search-bar input {
            flex: 1;
            border: none;
            padding: 0.75rem 1.25rem;
            font-size: 1rem;
            outline: none;
            background: transparent;
            color: var(--text-primary);
        }

        .search-bar button {
            background: var(--primary);
            border: none;
            color: white;
            padding: 0 1.5rem;
            cursor: pointer;
            font-size: 1.1rem;
            transition: background var(--transition-fast);
        }

            .search-bar button:hover {
                background: var(--primary-dark);
            }

        .user-actions {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .nav-icon {
            color: var(--text-primary);
            font-size: 1.3rem;
            text-decoration: none;
            position: relative;
            transition: color var(--transition-fast);
            cursor: pointer;
        }

            .nav-icon:hover {
                color: var(--primary);
            }

        .notification-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            box-shadow: 0 2px 4px rgba(251, 100, 27, 0.3);
        }

        .user-avatar {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 600;
            padding: 0.5rem 0.75rem;
            border-radius: 50px;
            transition: background var(--transition-fast);
            cursor: pointer;
        }

            .user-avatar:hover {
                background: rgba(40, 116, 240, 0.08);
            }

        /* Navigation Bar */
        #nav-bar {
            background: var(--card-bg);
            height: var(--nav-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            box-shadow: var(--shadow-sm);
            border-top: 1px solid var(--border-light);
            overflow-x: auto;
            scrollbar-width: none;
            white-space: nowrap;
        }

            #nav-bar::-webkit-scrollbar {
                display: none;
            }

            #nav-bar a {
                color: var(--text-secondary);
                text-decoration: none;
                font-weight: 500;
                font-size: 0.95rem;
                padding: 0.5rem 1rem;
                margin: 0 0.5rem;
                border-radius: var(--radius-sm);
                transition: all var(--transition-fast);
                white-space: nowrap;
            }

                #nav-bar a:hover,
                #nav-bar a.active {
                    color: var(--primary);
                    background: rgba(40, 116, 240, 0.08);
                    transform: translateY(-2px);
                }

        /* Mobile Hamburger */
        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
            background: none;
            border: none;
            color: var(--text-primary);
            cursor: pointer;
        }

        /* Main Content */
        #content {
            max-width: 1280px;
            margin: 2.5rem auto;
            padding: 0 1.5rem;
        }

        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .dashboard-card {
            background: var(--card-bg);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            padding: 1.75rem;
            transition: all var(--transition-normal);
            border: 1px solid var(--border-light);
        }

            .dashboard-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-md);
            }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary);
            margin: 0;
        }

        .stat-label {
            font-size: 0.95rem;
            color: var(--text-secondary);
            font-weight: 500;
            margin-top: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Footer */
        footer {
            background: var(--card-bg);
            padding: 2.5rem 1.5rem;
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
            border-top: 1px solid var(--border-light);
            margin-top: 3rem;
        }

            footer a {
                color: var(--primary);
                text-decoration: none;
                font-weight: 500;
                margin: 0 1rem;
                transition: color var(--transition-fast);
            }

                footer a:hover {
                    color: var(--accent);
                }

        /* Scroll to Top */
        #scrollToTop {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 50px;
            height: 50px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(40,116,240,0.3);
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 999;
        }

            #scrollToTop.visible {
                opacity: 1;
                visibility: visible;
            }

        /* Dark Mode Toggle */
        #darkModeToggle {
            background: none;
            border: none;
            font-size: 1.3rem;
            color: var(--text-primary);
            cursor: pointer;
            transition: transform 0.2s;
        }

            #darkModeToggle:hover {
                transform: rotate(15deg);
            }

        /* Responsive Design */
        @@media (max-width: 992px) {
            .search-bar

        {
            margin: 0 1rem;
            max-width: 400px;
        }

        }

        @@media (max-width: 768px) {
            #top-header

        {
            padding: 0.75rem 1rem;
            height: auto;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .logo {
            order: 1;
            flex: 1 1 100%;
            text-align: center;
            font-size: 1.5rem;
        }

        .search-bar {
            order: 3;
            max-width: 100%;
            margin: 0;
        }

        .user-actions {
            order: 2;
            justify-content: space-between;
            flex: 1 1 100%;
            gap: 0.75rem;
        }

        #nav-bar {
            display: none;
            padding: 0.5rem 1rem;
            height: auto;
            flex-wrap: wrap;
            justify-content: flex-start;
            border: none;
        }

            #nav-bar.show {
                display: flex;
            }

        .mobile-toggle {
            display: block;
        }

        #content {
            margin: 1.5rem auto;
            padding: 0 1rem;
        }

        .dashboard-cards {
            grid-template-columns: 1fr;
        }

        }

        @@media (max-width: 480px) {
            .user-avatar span

        {
            display: none;
        }

        .notification-badge {
            right: -4px;
            top: -4px;
            width: 16px;
            height: 16px;
            font-size: 0.6rem;
        }

        .search-bar button i {
            font-size: 1rem;
        }

        }

        /* Dropdown Menu */
        .dropdown-menu {
            border-radius: var(--radius-md);
            border: none;
            box-shadow: var(--shadow-md);
            padding: 0.75rem 0;
            animation: fadeIn 0.2s ease forwards;
            background: var(--card-bg);
            border: 1px solid var(--border-light);
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .dropdown-item {
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            color: var(--text-primary);
            transition: background var(--transition-fast);
        }

            .dropdown-item:hover {
                background: rgba(40, 116, 240, 0.08);
                color: var(--primary);
            }

        .dropdown-divider {
            margin: 0.5rem 0;
            border-color: var(--border-light);
        }

        /* Modal Styles */
        .modal-content {
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
        }

        .modal-header {
            border-bottom: 1px solid var(--border-light);
        }

        .modal-footer {
            border-top: 1px solid var(--border-light);
        }
    </style>
</head>
<body>
    <!-- Top Header -->
    <header id="top-header">
        <a asp-controller="UserDashboard" asp-action="Index" class="logo">
            Mobile Mart
        </a>

        <div class="search-bar">
            <div class="search-bar-inner">
                <input type="search" id="mainSearchInput" placeholder="Search for products, brands and more" aria-label="Search" />
                <button id="searchButton" aria-label="Search"><i class="fas fa-search"></i></button>
            </div>
        </div>

        <div class="user-actions">
            <button id="darkModeToggle" aria-label="Toggle Dark Mode">
                <i class="fas fa-moon"></i>
            </button>

           @*  <a id="notificationBell" class="nav-icon" aria-label="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notification-badge">3</span>
            </a> *@

            <a id="cartIcon" asp-controller="AddToCart" asp-action="Index" class="nav-icon" aria-label="Shopping Cart">
                <i class="fas fa-shopping-cart"></i>
            </a>

            <a asp-controller="AddToOrder" asp-action="GetOrderItems" class="nav-icon mx-2" aria-label="My Orders" title="My Orders">
                <i class="fas fa-box-open" style="font-size: 22px; color: #2874f0;"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7rem; min-width: 1.2rem; height: 1.2rem;">
                    2
                </span>
            </a>

            <div class="dropdown">
                <a class="user-avatar dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle" style="font-size: 36px; color: #2874f0;"></i>
                </a>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


                <ul class="dropdown-menu dropdown-menu-end">
@*                     <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i> My Profile</a></li> *@
                    <li><a class="dropdown-item" asp-controller="AddToCart" asp-action="Index"><i class="fas fa-heart me-2"></i> Wishlist</a></li>
                   
                    <li>
                        <a class="dropdown-item" asp-controller="AddToOrder" asp-action="GetOrderItems">
                            <i class="fas fa-shopping-bag me-2"></i> My Orders
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a asp-controller="Login" asp-action="Logout" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                </ul>
            </div>

            <button class="mobile-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#nav-bar" aria-controls="nav-bar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </header>

    <!-- Navigation Bar -->
    <nav id="nav-bar" class="collapse navbar-collapse" aria-label="Primary Navigation">
        <a asp-controller="UserDashboard" asp-action="Index" class="active">Home</a>
        <a asp-controller="UserDashboard" asp-action="Index"><i class="fas fa-mobile-alt me-1"></i> Mobiles</a>
        <a asp-controller="UserDashboard" asp-action="Index"><i class="fas fa-tv me-1"></i> Electronics</a>
        <a asp-controller="UserDashboard" asp-action="Index"><i class="fas fa-tags me-1"></i> Offers</a>
    </nav>

    <!-- Main Content -->
    <main id="content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        &copy; 2025 Mobile Mart. All rights reserved.
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Service</a>
        <a href="#">Contact Us</a>
        <div class="mt-2">
            <small>Need help? <a href="#" class="text-primary">Chat with us</a></small>
        </div>
    </footer>

    <!-- Scroll to Top Button -->
    <div id="scrollToTop" class="rounded-circle">
        <i class="fas fa-arrow-up"></i>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="notificationModalLabel">Notifications</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">Order Confirmed</h6>
                                <small>2 mins ago</small>
                            </div>
                            <p class="mb-1">Your order #12345 has been confirmed.</p>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">New Offer!</h6>
                                <small>1 hour ago</small>
                            </div>
                            <p class="mb-1">Get 20% off on smartphones this weekend.</p>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">Delivery Update</h6>
                                <small>3 hours ago</small>
                            </div>
                            <p class="mb-1">Your package is out for delivery.</p>
                        </a>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // === Dark Mode Toggle ===
            const toggle = document.getElementById('darkModeToggle');
            const root = document.getElementById('theme-root');

            // Check saved preference
            if (localStorage.getItem('theme') === 'dark') {
                root.setAttribute('data-theme', 'dark');
                toggle.innerHTML = '<i class="fas fa-sun"></i>';
            }

            toggle.addEventListener('click', () => {
                if (root.getAttribute('data-theme') === 'dark') {
                    root.removeAttribute('data-theme');
                    localStorage.setItem('theme', 'light');
                    toggle.innerHTML = '<i class="fas fa-moon"></i>';
                } else {
                    root.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                    toggle.innerHTML = '<i class="fas fa-sun"></i>';
                }
            });

            // === Dynamic Greeting ===
            const now = new Date();
            const hour = now.getHours();
            let greeting = "Hello";
            if (hour < 12) greeting = "Good Morning";
            else if (hour < 18) greeting = "Good Afternoon";
            else greeting = "Good Evening";

            document.getElementById('userGreeting').textContent = greeting + ", John";

            // === Search Functionality ===
            document.getElementById('searchButton').addEventListener('click', function() {
                const query = document.getElementById('mainSearchInput').value.trim();
                if (query) {
                    console.log("Search submitted:", query);
                    // TODO: Redirect or fetch results
                    alert("Searching for: " + query);
                }
            });

            // === Notification Modal ===
            document.getElementById('notificationBell').addEventListener('click', function(e) {
                e.preventDefault();
                const modal = new bootstrap.Modal(document.getElementById('notificationModal'));
                modal.show();
            });

            // === Scroll to Top ===
            const scrollToTopBtn = document.getElementById("scrollToTop");
            window.addEventListener("scroll", () => {
                if (window.scrollY > 300) {
                    scrollToTopBtn.classList.add("visible");
                } else {
                    scrollToTopBtn.classList.remove("visible");
                }
            });

            scrollToTopBtn.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // === Chart (if exists) ===
            const ctx = document.getElementById('orderChart');
            if (ctx) {
                new Chart(ctx.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                        datasets: [{
                            label: 'Orders',
                            data: [12, 19, 8, 15, 24, 18],
                            backgroundColor: 'rgba(40, 116, 240, 0.1)',
                            borderColor: 'rgba(40, 116, 240, 1)',
                            borderWidth: 2,
                            tension: 0.3,
                            fill: true,
                            pointBackgroundColor: '#fff',
                            pointBorderWidth: 2,
                            pointHoverRadius: 6,
                        }],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                labels: {
                                    font: { size: 12, family: 'Poppins' },
                                    padding: 20
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0,0,0,0.05)' },
                                ticks: { font: { family: 'Poppins' } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Poppins' } }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>