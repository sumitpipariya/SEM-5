<!DOCTYPE html>
<!-- beautify ignore:start -->
<html lang="en"
      class="light-style layout-menu-fixed"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="~/assets/"
      data-template="vertical-menu-template-free">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>Mobile Mart Project</title>
    <meta name="description" content="" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/assets/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/assets/vendor/css/core.css" class="template-customizer-core-css" />
    <link rel="stylesheet" href="~/assets/vendor/css/theme-default.css" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="~/assets/css/demo.css" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/apex-charts/apex-charts.css" />

    <!-- CUSTOM PREMIUM STYLES -->
    <style>
        :root {
            --primary: #4f46e5;
            --primary-light: #eef2ff;
            --success: #10b981;
            --gray-100: #f8fafc;
            --gray-200: #f1f5f9;
            --gray-700: #334155;
            --gray-800: #1e293b;
            --radius: 16px;
            --radius-md: 12px;
            --shadow-sm: 0 2px 6px rgba(0, 0, 0, 0.03);
            --shadow: 0 6px 18px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        /* ======== SIDEBAR ======== */
        .layout-menu {
            border-right: 1px solid var(--gray-200) !important;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%) !important;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow-sm);
        }

        .app-brand {
            padding: 1.5rem 1rem !important;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .app-brand-icon {
            font-size: 1.8rem;
            background: linear-gradient(135deg, #4f46e5, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            transition: transform 0.3s ease;
        }

        .app-brand-link:hover .app-brand-icon {
            transform: rotate(15deg) scale(1.1);
        }

        .app-brand-text {
            font-weight: 800 !important;
            font-size: 1.35rem !important;
            background: linear-gradient(90deg, #4f46e5, #7c3aed, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: -0.5px;
            transition: letter-spacing 0.3s ease;
        }

        .app-brand-link:hover .app-brand-text {
            letter-spacing: 0;
        }

        .menu-inner .menu-item {
            margin: 4px 0;
        }

        .menu-inner .menu-link {
            height: 48px;
            border-radius: var(--radius-md);
            margin: 0 8px;
            transition: var(--transition);
            font-weight: 500;
            color: var(--gray-700);
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .menu-inner .menu-link:hover {
                background: var(--primary-light);
                color: var(--primary) !important;
                transform: translateX(4px);
            }

        .menu-inner .menu-item.active .menu-link {
            background: var(--primary-light) !important;
            color: var(--primary) !important;
            box-shadow: 0 2px 8px rgba(79, 70, 229, 0.15);
            transform: translateX(4px);
        }

        .menu-icon {
            font-size: 1.25rem !important;
            min-width: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* ======== NAVBAR ======== */
        .layout-navbar {
            border-bottom: 1px solid var(--gray-200) !important;
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(10px);
            box-shadow: var(--shadow-sm);
        }

        .navbar-nav .nav-item .nav-link {
            font-weight: 500;
            color: var(--gray-700);
            transition: var(--transition);
        }

            .navbar-nav .nav-item .nav-link:hover {
                color: var(--primary);
            }

        .form-control {
            background: var(--gray-100) !important;
            border: none !important;
            padding: 0.5rem 1rem !important;
            border-radius: 50px !important;
            font-weight: 500;
        }

            .form-control:focus {
                background: white !important;
                box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.2) !important;
            }

        .avatar {
            transition: var(--transition);
        }

            .avatar:hover {
                transform: scale(1.05);
            }

        /* ======== CONTENT AREA ======== */
        .content-wrapper {
            background: #fafbfc;
            min-height: calc(100vh - 64px);
            padding: 2rem 1.5rem;
        }

        .container-p-y {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ======== DROPDOWN ======== */
        .dropdown-menu {
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 0.75rem 0;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .dropdown-item {
            padding: 0.6rem 1.5rem;
            font-weight: 500;
            transition: var(--transition);
            color: var(--gray-700);
        }

            .dropdown-item:hover {
                background: var(--primary-light);
                color: var(--primary);
                transform: translateX(4px);
            }

        .dropdown-divider {
            margin: 0.5rem 0;
            border-color: var(--gray-200);
        }

        /* ======== TOGGLE BUTTON ======== */
        .layout-menu-toggle {
            color: var(--gray-700) !important;
            transition: var(--transition);
        }

            .layout-menu-toggle:hover {
                color: var(--primary) !important;
                transform: rotate(180deg);
            }

        /* ======== SCROLLBAR ======== */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--gray-200);
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--gray-300);
            }

        /* ======== RESPONSIVE ======== */
        @@media (max-width: 1200px) {
            .content-wrapper {
                padding: 1.5rem 1rem;
            }
        }

        @@media (max-width: 992px) {
            .layout-menu {
                transform: translateX(-100%);
            }

            .layout-menu-active .layout-menu {
                transform: translateX(0);
            }

            .content-wrapper {
                padding-top: 1rem;
            }
        }

        /* ======== MICRO INTERACTIONS ======== */
        .hover-lift {
            transition: var(--transition);
        }

            .hover-lift:hover {
                transform: translateY(-2px);
            }

        .btn-soft {
            background: var(--gray-100);
            border: 1px solid var(--gray-200);
            color: var(--gray-700);
            font-weight: 500;
            border-radius: var(--radius-md);
            padding: 0.4rem 1rem;
        }

            .btn-soft:hover {
                background: var(--primary-light);
                color: var(--primary);
                border-color: var(--primary-light);
            }
    </style>

    <!-- Helpers -->
    <script src="~/assets/vendor/js/helpers.js"></script>

    <!--! Template customizer & Theme config files MUST be included after core stylesheets and helpers.js -->
    <script src="~/assets/js/config.js"></script>

    <!-- Page-specific CSS (if any) -->
    @RenderSection("Styles", required: false)
</head>

<body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo">
                    <a asp-controller="Home" asp-action="Index" class="app-brand-link d-flex align-items-center gap-2">
                        <i class="bi bi-phone-fill app-brand-icon"></i>
                        <span class="app-brand-text">Mobile Mart</span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-block d-xl-none">
                        <i class="bx bx-chevron-left bx-sm align-middle"></i>
                    </a>
                </div>
                <div class="menu-inner-shadow"></div>
                <ul class="menu-inner py-3">

                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    }

                    <!-- Dashboard -->
                    <li class="menu-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <a asp-controller="Home" asp-action="Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home-circle"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>

                    <!-- User List -->
                    <li class="menu-item @(currentController == "User" ? "active" : "")">
                        <a asp-controller="User" asp-action="GetAllUser" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-user"></i>
                            <div>Users</div>
                        </a>
                    </li>

                    <!-- Product List -->
                    <li class="menu-item @(currentController == "Product" ? "active" : "")">
                        <a asp-controller="Product" asp-action="GetAllProduct" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-package"></i>
                            <div>Products</div>
                        </a>
                    </li>

                    <!-- Order Items -->
                    <li class="menu-item @(currentController == "OrderItems" ? "active" : "")">
                        <a asp-controller="OrderItems" asp-action="GetAllOrderItem" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-list-ul"></i>
                            <div>Order Items</div>
                        </a>
                    </li>

                    <!-- Orders -->
                    <li class="menu-item @(currentController == "Orders" ? "active" : "")">
                        <a asp-controller="Orders" asp-action="GetAllOrder" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-shopping-bag"></i>
                            <div>Orders</div>
                        </a>
                    </li>

                    <!-- Category -->
                    <li class="menu-item @(currentController == "Category" ? "active" : "")">
                        <a asp-controller="Category" asp-action="GetAllCategory" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-category"></i>
                            <div>Category</div>
                        </a>
                    </li>

                    <!-- Carts -->
                    <li class="menu-item @(currentController == "Cart" ? "active" : "")">
                        <a asp-controller="Cart" asp-action="GetAllCarts" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-cart"></i>
                            <div>Carts</div>
                        </a>
                    </li>

                    <!-- Brands -->
                    <li class="menu-item @(currentController == "Brand" ? "active" : "")">
                        <a asp-controller="Brand" asp-action="GetAllBrand" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-award"></i>
                            <div>Brands</div>
                        </a>
                    </li>

@*                <li class="menu-item @(currentController == "ProductImage" ? "active" : "")">
                        <a asp-controller="ProductImage" asp-action="Index" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-image"></i>
                            <div>Product Images</div>
                        </a>
                    </li> *@

                    <!-- Logout -->
                    <li class="menu-item">
                        <a asp-controller="Login" asp-action="Logout" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-log-out"></i>
                            <div>Logout</div>
                        </a>
                    </li>
                </ul>
            </aside>
            <!-- / Menu -->
            <!-- Layout container -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme mb-3"
                     id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                            <i class="bx bx-menu bx-sm"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <!-- Search -->
                        <div class="navbar-nav align-items-center me-3">
                            <div class="nav-item d-flex align-items-center">
                                <i class="bx bx-search fs-4 lh-0 text-muted me-2"></i>
                                <input type="text"
                                       class="form-control border-0 shadow-none"
                                       placeholder="Search..."
                                       aria-label="Search..." />
                            </div>
                        </div>
                        <!-- /Search -->

                        <ul class="navbar-nav flex-row align-items-center ms-auto">
                            <!-- User -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                                    <div class="avatar avatar-online">
                                        <img src="~/assets/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle" />
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <div class="d-flex align-items-center">
                                                <div class="flex-shrink-0 me-3">
                                                    <div class="avatar avatar-online">
                                                        <img src="~/assets/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle" />
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <span class="fw-semibold d-block">John Doe</span>
                                                    <small class="text-muted">Admin</small>
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="bx bx-user me-2"></i>
                                            <span class="align-middle">My Profile</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            <i class="bx bx-cog me-2"></i>
                                            <span class="align-middle">Settings</span>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <a asp-controller="Login" asp-action="Logout" class="dropdown-item">
                                            <i class="bx bx-power-off me-2"></i>
                                            <span class="align-middle">Log Out</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <!--/ User -->
                        </ul>
                    </div>
                </nav>
                <!-- / Navbar -->
                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <div >
                        @RenderBody()
                    </div>
                    <div class="content-backdrop fade"></div>
                </div>
                <!-- Content wrapper -->
            </div>
            <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    <!-- / Layout wrapper -->
    <!-- Core JS -->
    <!-- build:js assets/vendor/js/core.js -->
    <script src="~/assets/vendor/libs/jquery/jquery.js"></script>
    <script src="~/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/assets/vendor/js/bootstrap.js"></script>
    <script src="~/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>

    <script src="~/assets/vendor/js/menu.js"></script>
    <!-- endbuild -->
    <!-- Vendors JS -->
    <script src="~/assets/vendor/libs/apex-charts/apexcharts.js"></script>

    <!-- Main JS -->
    <script src="~/assets/js/main.js"></script>

    <!-- Page JS -->
    <script src="~/assets/js/dashboards-analytics.js"></script>

    <!-- Place this tag in your head or just before your close body tag. -->
    <script async defer src="https://buttons.github.io/buttons.js"></script>

    <!-- Bootstrap Bundle (fallback if needed) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

    <!-- CUSTOM JS FOR MICRO INTERACTIONS -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add hover lift to cards if any in content
            const cards = document.querySelectorAll('.card');
            cards.forEach(card => {
                card.classList.add('hover-lift');
            });
        });
    </script>
</body>
</html>