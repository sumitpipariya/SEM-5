@model List<My_Project.Models.OrderItemModel>

@{
    ViewData["Title"] = "My Order Items";
    Layout = "_Layout_User";
}

<!-- Google Fonts - Poppins -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Font Awesome 6 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.4/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />

<!-- Bootstrap Icons (Optional Enhancement) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* ===== BASE TYPOGRAPHY & LAYOUT ===== */
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f9fafb;
        color: #333;
    }

    h1, h2, h3, h4, h5 {
        font-weight: 600;
        letter-spacing: -0.5px;
    }

    .text-gradient {
        background: linear-gradient(135deg, #6e48aa, #9d50bb);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ===== CARD & TABLE STYLING ===== */
    .order-card {
        border-radius: 24px;
        border: none;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.04);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
    }

        .order-card:hover {
            box-shadow: 0 20px 40px rgba(110, 72, 170, 0.12);
            transform: translateY(-8px);
        }

    .table thead th {
        background: linear-gradient(135deg, #6e48aa, #9d50bb);
        color: white;
        border: none;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 1.25rem 1rem;
    }

    .table tbody td {
        font-weight: 500;
        vertical-align: middle;
        padding: 1.5rem 1rem;
        color: #444;
        border-color: #f1f1f1;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f5ff !important;
        transition: background 0.25s ease;
    }

    /* ===== BUTTONS ===== */
    .btn-primary {
        background: linear-gradient(135deg, #6e48aa, #9d50bb);
        border: none;
        border-radius: 50px;
        padding: 14px 36px;
        font-weight: 600;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        font-size: 0.95rem;
        box-shadow: 0 4px 20px rgba(157, 80, 187, 0.35);
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #5a3a8c, #8a42a0);
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(157, 80, 187, 0.5);
            letter-spacing: 1px;
        }

    .btn-outline-shopping {
        border: 2px solid #9d50bb;
        color: #9d50bb;
        border-radius: 50px;
        padding: 12px 30px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-outline-shopping:hover {
            background: #9d50bb;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(157, 80, 187, 0.3);
        }

    /* ===== ALERT BOX ===== */
    .empty-state {
        border-radius: 20px;
        background: linear-gradient(135deg, #e3f2fd, #f0f7ff);
        border: 2px dashed #bbdefb;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 5px 20px rgba(21, 101, 192, 0.08);
    }

        .empty-state i {
            font-size: 3.5rem;
            color: #1e88e5;
            margin-bottom: 1.5rem;
        }

        .empty-state h5 {
            font-size: 1.4rem;
            color: #0d47a1;
            margin-bottom: 0.75rem;
        }

        .empty-state p {
            font-size: 1rem;
            color: #555;
            max-width: 500px;
            margin: 0 auto 1.5rem;
        }

    /* ===== TOTAL BANNER ===== */
    .total-banner {
        background: linear-gradient(135deg, #f9f4ff, #ede4ff);
        border-radius: 24px;
        padding: 2rem;
        border: 1px solid #e0d0fa;
        box-shadow: 0 6px 25px rgba(110, 72, 170, 0.08);
        backdrop-filter: blur(10px);
    }

    .total-amount {
        font-size: 1.75rem;
        font-weight: 700;
        color: #4a2e7d;
    }

    .total-label {
        font-size: 1.1rem;
        color: #666;
        font-weight: 500;
    }

    /* ===== RESPONSIVE MOBILE TABLE ===== */
    @@media (max-width: 768px) {
        .container {
            padding: 0 16px;
        }

        .table thead {
            display: none;
        }

        .table tbody tr {
            display: block;
            margin-bottom: 1.5rem;
            padding: 1.25rem;
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            background: white;
            margin-left: 0 !important;
            margin-right: 0 !important;
            border: 1px solid #f0f0f0;
        }

        .table tbody td {
            display: flex;
            justify-content: space-between;
            padding: 0.85rem 0;
            border-bottom: 1px dashed #eee;
            font-size: 0.95rem;
        }

            .table tbody td:last-child {
                border-bottom: none;
            }

            .table tbody td::before {
                content: attr(data-label);
                font-weight: 700;
                color: #6e48aa;
                width: 42%;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .total-banner {
            flex-direction: column;
            gap: 1.5rem;
            text-align: center;
            padding: 1.5rem;
        }

        .btn-primary {
            width: 100%;
            margin-top: 1rem;
            font-size: 1rem;
            padding: 14px;
        }

        .empty-state {
            padding: 2rem 1.5rem;
        }

            .empty-state i {
                font-size: 2.8rem;
            }

            .empty-state h5 {
                font-size: 1.25rem;
            }
    }

    /* ===== ANIMATIONS ===== */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-in {
        animation: fadeInUp 0.6s ease forwards;
    }

    .delay-1 {
        animation-delay: 0.1s;
    }

    .delay-2 {
        animation-delay: 0.2s;
    }

    .delay-3 {
        animation-delay: 0.3s;
    }
</style>

<div class="container mt-4 animate-in">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-0">
                <i class="fas fa-box-open me-3 text-primary"></i>
                <span class="text-gradient">My Order Items</span>
            </h2>
            <p class="text-muted">View all products you've ordered.</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state animate-in delay-1">
            <i class="fas fa-boxes-stacked"></i>
            <h5>No Order Items Found</h5>
            <p>You haven’t placed any orders yet. Browse our catalog and start shopping today!</p>
            <a asp-controller="UserDashboard" asp-action="Index" class="btn btn-outline-shopping">
                <i class="fas fa-shopping-bag me-2"></i> Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="order-card animate-in delay-2">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-borderless align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Product</th>
                                <th style="width:110px;">Qty</th>
                                <th style="width:130px;">Price</th>
                                <th style="width:130px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4" data-label="Product">
                                        <div class="d-flex align-items-center">
                                            <div class="me-3">
                                                <i class="fas fa-gift text-muted"></i>
                                            </div>
                                            <span>@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td data-label="Qty">
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                            @item.Quantity
                                        </span>
                                    </td>
                                    <td data-label="Price">₹@String.Format("{0:N2}", item.Price ?? 0m)</td>
                                    <td data-label="Total" class="fw-bold text-success">
                                        ₹@String.Format("{0:N2}", (item.Price ?? 0m) * item.Quantity)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Total Amount Banner -->
        <div class="total-banner d-flex flex-column flex-md-row justify-content-between align-items-center mt-5 animate-in delay-3">
            <div>
                <div class="total-label">ORDER TOTAL</div>
                <div class="total-amount">
                    ₹@String.Format("{0:N2}", Model.Sum(x => (x.Price ?? 0m) * x.Quantity))
                </div>
            </div>
            <a asp-controller="UserDashboard" asp-action="Index" class="btn btn-primary mt-3 mt-md-0">
                <i class="fas fa-shopping-bag me-2"></i> Continue Shopping
            </a>
        </div>
    }
</div>

<!-- Optional: Add subtle entrance animations -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const animatedElements = document.querySelectorAll('.animate-in');
        animatedElements.forEach((el, index) => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            setTimeout(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
            }, 100 * (index + 1));
        });
    });
</script>