@model List<My_Project.Models.OrderModel>
@{
    ViewData["Title"] = "My Orders";
    Layout = "_Layout_User"; // Use your user layout
}

<div class="container-fluid">
    <!-- Premium Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="premium-header-card">
                <div class="premium-header-bg"></div>
                <div class="premium-header-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center">
                                <div class="premium-icon-wrapper">
                                    <i class="bx bx-receipt"></i>
                                    <div class="premium-icon-glow"></div>
                                </div>
                                <div class="ms-4">
                                    <h1 class="premium-title">My Orders</h1>
                                    <p class="premium-subtitle">Track your order history and status</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                            <div class="premium-action-buttons">
                                <a asp-controller="Product" asp-action="Index" class="btn premium-btn-primary">
                                    <i class="bx bx-shopping-bag me-2"></i>
                                    Continue Shopping
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="premium-header-particles">
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="premium-alert alert-danger">
            <div class="premium-alert-icon">
                <i class="bx bx-error-circle"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Error!</div>
                <div class="premium-alert-message">@TempData["Error"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bx bx-x"></i>
            </button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="premium-alert alert-success">
            <div class="premium-alert-icon">
                <i class="bx bx-check-circle"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Success!</div>
                <div class="premium-alert-message">@TempData["Success"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bx bx-x"></i>
            </button>
        </div>
    }

    <!-- Premium Search Panel -->
    <div class="premium-search-panel mb-4">
        <div class="premium-search-header">
            <div class="d-flex align-items-center">
                <div class="premium-search-icon">
                    <i class="bx bx-filter-alt"></i>
                </div>
                <h5 class="premium-search-title">Search & Filter</h5>
            </div>
            <button class="premium-toggle-btn" data-bs-toggle="collapse" data-bs-target="#searchPanel">
                <i class="bx bx-chevron-down"></i>
            </button>
        </div>
        <div class="collapse show" id="searchPanel">
            <div class="premium-search-content">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Search Orders</label>
                            <div class="premium-input-wrapper">
                                <i class="bx bx-search premium-input-icon"></i>
                                <input type="text" id="searchInput" class="premium-form-control"
                                       placeholder="Search by order ID...">
                                <div class="premium-input-focus"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Status</label>
                            <div class="premium-select-wrapper">
                                <select id="statusFilter" class="premium-form-select">
                                    <option value="">All Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Processing">Processing</option>
                                    <option value="Shipped">Shipped</option>
                                    <option value="Delivered">Delivered</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                                <i class="bx bx-chevron-down premium-select-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Date Range</label>
                            <div class="premium-select-wrapper">
                                <select id="dateFilter" class="premium-form-select">
                                    <option value="">All Dates</option>
                                    <option value="today">Today</option>
                                    <option value="week">This Week</option>
                                    <option value="month">This Month</option>
                                    <option value="quarter">This Quarter</option>
                                </select>
                                <i class="bx bx-chevron-down premium-select-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-12">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Actions</label>
                            <div class="d-flex gap-2">
                                <button type="button" class="premium-action-btn" onclick="clearFilters()" data-bs-toggle="tooltip" title="Clear filters">
                                    <i class="bx bx-refresh"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Orders Table -->
    <div class="premium-table-container">
        <div class="premium-table-header">
            <div class="d-flex align-items-center">
                <div class="premium-table-icon">
                    <i class="bx bx-table"></i>
                </div>
                <div>
                    <h5 class="premium-table-title">My Order History</h5>
                    <span class="premium-table-badge" id="totalCount">@(Model?.Count ?? 0) orders</span>
                </div>
            </div>
        </div>

        <div class="premium-table-wrapper">
            <table class="premium-table" id="ordersTable">
                <thead>
                    <tr>
                        <th class="premium-th">
                            <div class="premium-th-content">
                                <i class="bx bx-hash"></i>
                                <span>Order ID</span>
                            </div>
                        </th>
                        <th class="premium-th">
                            <div class="premium-th-content">
                                <i class="bx bx-calendar"></i>
                                <span>Date</span>
                            </div>
                        </th>
                        <th class="premium-th">
                            <div class="premium-th-content">
                                <i class="bx bx-rupee"></i>
                                <span>Total Amount</span>
                            </div>
                        </th>
                        <th class="premium-th">
                            <div class="premium-th-content">
                                <i class="bx bx-flag"></i>
                                <span>Status</span>
                            </div>
                        </th>
                        <th class="premium-th text-center">
                            <div class="premium-th-content justify-content-center">
                                <i class="bx bx-cog"></i>
                                <span>Actions</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="orderTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr class="premium-tr" data-order-id="@order.OrderId"
                                data-order-date="@order.OrderDate?.ToString("yyyy-MM-dd")"
                                data-status="@(order.Status ?? "")"
                                data-total="@order.TotalAmount">
                                <td class="premium-td">
                                    <span class="premium-id-badge">#ORD-@order.OrderId</span>
                                </td>
                                <td class="premium-td">
                                    <div class="premium-date-info">
                                        <div class="premium-date-main">
                                            @order.OrderDate?.ToString("MMM dd, yyyy")
                                        </div>
                                        <div class="premium-date-time">
                                            @order.OrderDate?.ToString("hh:mm tt")
                                        </div>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    <div class="premium-amount-info">
                                        <div class="premium-amount-main">₹@(order.TotalAmount?.ToString("N2") ?? "0.00")</div>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    @{
                                        var statusClass = order.Status?.ToLower() switch
                                        {
                                            "completed" => "badge-success",
                                            "delivered" => "badge-success",
                                            "shipped" => "badge-info",
                                            "processing" => "badge-warning",
                                            "pending" => "badge-warning",
                                            "cancelled" => "badge-danger",
                                            _ => "badge-secondary"
                                        };
                                        var statusIcon = order.Status?.ToLower() switch
                                        {
                                            "completed" => "bx-check-circle",
                                            "delivered" => "bx-package",
                                            "shipped" => "bx-car",
                                            "processing" => "bx-loader-alt",
                                            "pending" => "bx-time",
                                            "cancelled" => "bx-x-circle",
                                            _ => "bx-help-circle"
                                        };
                                    }
                                    <span class="premium-badge @statusClass">
                                        <i class="bx @statusIcon"></i>
                                        @(order.Status ?? "Unknown")
                                    </span>
                                </td>
                                <td class="premium-td text-center">
                                    <div class="premium-action-group">
                                        <a asp-controller="AddToOrder" asp-action="Details" asp-route-id="@order.OrderId"
                                           class="premium-action-btn action-view" data-bs-toggle="tooltip" title="View Details">
                                            <i class="bx bx-show"></i>
                                        </a>
                                        @if (order.Status?.ToLower() == "completed" || order.Status?.ToLower() == "delivered")
                                        {
                                            <a href="#" class="premium-action-btn action-print" data-bs-toggle="tooltip" title="Download Invoice">
                                                <i class="bx bx-download"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noOrdersRow">
                            <td colspan="5" class="premium-empty-state">
                                <div class="premium-empty-content">
                                    <div class="premium-empty-icon">
                                        <i class="bx bx-receipt"></i>
                                        <div class="premium-empty-glow"></div>
                                    </div>
                                    <h5 class="premium-empty-title">No orders found</h5>
                                    <p class="premium-empty-message">You haven't placed any orders yet. Start shopping to see your order history here.</p>
                                    <a asp-controller="Product" asp-action="Index" class="premium-btn-primary">
                                        <i class="bx bx-plus-circle me-2"></i>Start Shopping
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Premium Delete Modal (Optional - if you allow user to cancel orders) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title">
                    <i class="bx bx-trash text-danger me-2 fs-4"></i>Confirm Cancel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4">
                <i class="bx bx-error-circle text-danger display-1"></i>
                <h6 class="mt-3 fw-bold">Are you sure you want to cancel this order?</h6>
                <p class="text-muted">
                    This action cannot be undone. This will cancel the order if it hasn't been processed yet.
                </p>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">No, Keep Order</button>
                <a id="confirmDeleteBtn" class="btn btn-danger px-4">
                    <i class="bx bx-trash me-1"></i>Yes, Cancel Order
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-100: #f8f9fa;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-icon-wrapper {
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-title {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .premium-subtitle {
        font-size: 1.25rem;
        opacity: 0.9;
        font-weight: 300;
        margin-bottom: 0;
    }

    /* Premium Buttons */
    .premium-btn-primary {
        background: var(--premium-light);
        color: #667eea;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: var(--premium-transition);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: #5a67d8;
        }

    /* Premium Alerts */
    .premium-alert {
        display: flex;
        align-items: center;
        padding: 1rem 1.5rem;
        border-radius: var(--premium-border-radius);
        margin-bottom: 1rem;
        border: none;
        box-shadow: var(--premium-shadow);
        position: relative;
        overflow: hidden;
    }

        .premium-alert::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
        }

    .alert-danger {
        background: linear-gradient(135deg, rgba(250, 112, 154, 0.1), rgba(254, 225, 64, 0.1));
        color: #dc3545;
    }

        .alert-danger::before {
            background: var(--premium-danger);
        }

    .alert-success {
        background: linear-gradient(135deg, rgba(79, 172, 254, 0.1), rgba(0, 242, 254, 0.1));
        color: #198754;
    }

        .alert-success::before {
            background: var(--premium-success);
        }

    .premium-alert-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .alert-danger .premium-alert-icon {
        background: rgba(220, 53, 69, 0.1);
    }

    .alert-success .premium-alert-icon {
        background: rgba(25, 135, 84, 0.1);
    }

    .premium-alert-title {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .premium-alert-message {
        margin-bottom: 0;
        opacity: 0.8;
    }

    .premium-alert-close {
        background: none;
        border: none;
        font-size: 1.25rem;
        margin-left: auto;
        padding: 0.25rem;
        border-radius: 50%;
        transition: var(--premium-transition);
    }

        .premium-alert-close:hover {
            background: rgba(0, 0, 0, 0.1);
        }

    /* Premium Search Panel */
    .premium-search-panel {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        overflow: hidden;
    }

    .premium-search-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, var(--premium-gray-50), var(--premium-gray-100));
        border-bottom: 1px solid var(--premium-gray-200);
    }

    .premium-search-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--premium-border-radius);
        background: var(--premium-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--premium-light);
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .premium-search-title {
        margin: 0;
        font-weight: 700;
        color: var(--premium-gray-900);
    }

    .premium-toggle-btn {
        background: none;
        border: 1px solid var(--premium-gray-300);
        padding: 0.5rem 1rem;
        border-radius: var(--premium-border-radius);
        color: var(--premium-gray-600);
        transition: var(--premium-transition);
    }

        .premium-toggle-btn:hover {
            background: var(--premium-gray-100);
            border-color: var(--premium-gray-400);
        }

    .premium-search-content {
        padding: 2rem;
        background: rgba(248, 249, 250, 0.5);
    }

    .premium-form-group {
        margin-bottom: 0;
    }

    .premium-form-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--premium-gray-600);
        margin-bottom: 0.5rem;
        display: block;
    }

    .premium-input-wrapper {
        position: relative;
    }

    .premium-form-control {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 2px solid var(--premium-gray-200);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        font-size: 0.875rem;
        transition: var(--premium-transition);
        outline: none;
    }

        .premium-form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .premium-input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--premium-gray-500);
        font-size: 1rem;
        z-index: 2;
    }

    .premium-input-focus {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--premium-primary);
        transform: scaleX(0);
        transition: var(--premium-transition);
    }

    .premium-form-control:focus + .premium-input-focus {
        transform: scaleX(1);
    }

    .premium-select-wrapper {
        position: relative;
    }

    .premium-form-select {
        width: 100%;
        padding: 0.75rem 3rem 0.75rem 1rem;
        border: 2px solid var(--premium-gray-200);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        font-size: 0.875rem;
        transition: var(--premium-transition);
        outline: none;
        appearance: none;
    }

        .premium-form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .premium-select-icon {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--premium-gray-500);
        pointer-events: none;
    }

    .premium-action-btn {
        width: 40px;
        height: 40px;
        border: 2px solid var(--premium-gray-200);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        color: var(--premium-gray-600);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--premium-transition);
        text-decoration: none;
    }

        .premium-action-btn:hover {
            border-color: #667eea;
            color: #667eea;
            background: rgba(102, 126, 234, 0.05);
            transform: translateY(-2px);
        }

    /* Premium Table */
    .premium-table-container {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        overflow: hidden;
    }

    .premium-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, var(--premium-gray-50), var(--premium-gray-100));
        border-bottom: 1px solid var(--premium-gray-200);
    }

    .premium-table-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--premium-border-radius);
        background: var(--premium-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--premium-light);
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .premium-table-title {
        margin: 0;
        font-weight: 700;
        color: var(--premium-gray-900);
