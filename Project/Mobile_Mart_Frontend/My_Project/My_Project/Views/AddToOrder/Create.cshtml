@model My_Project.Models.OrderModel
@{
    ViewData["Title"] = "Confirm Order";
    Layout = "_Layout_User";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-bag-check"></i> Confirm Your Order</h4>
                </div>
                <div class="card-body">
                    <!-- Display Errors -->
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Order Form -->
                    <form id="orderForm">
                        @Html.AntiForgeryToken()

                        <!-- Hidden Fields -->
                        <input type="hidden" name="ProductId" id="productId" value="@ViewBag.ProductId" />
                        <input type="hidden" name="Quantity" id="quantity" value="@ViewBag.Quantity" />
                        <input type="hidden" name="Price" id="price" value="@ViewBag.Price" />
                        <input type="hidden" name="UserId" value="@ViewBag.UserId" />

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <h5>Product Details</h5>
                                <div class="border p-3 rounded">
                                    <h6 id="productName">@ViewBag.ProductName</h6>
                                    <p class="text-muted">Price: ₹<span id="productPrice">@ViewBag.Price</span></p>
                                    <div class="d-flex align-items-center">
                                        <label class="me-3">Quantity:</label>
                                        <span class="badge bg-secondary rounded-pill px-3 py-2" id="productQuantity">@ViewBag.Quantity</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <h5>Order Summary</h5>
                                <div class="border p-3 rounded bg-light">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal:</span>
                                        <strong>₹<span id="subtotal">@(ViewBag.Price * ViewBag.Quantity)</span></strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Shipping:</span>
                                        <strong>₹0.00</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax:</span>
                                        <strong>₹0.00</strong>
                                    </div>
                                    <hr />
                                    <div class="d-flex justify-content-between">
                                        <h5>Total:</h5>
                                        <h5 class="text-success">₹<span id="totalAmount">@(ViewBag.Price * ViewBag.Quantity)</span></h5>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5>Shipping Address</h5>
                            <div class="border p-3 rounded" id="shippingAddress">
                                <p class="mb-1"><strong id="userFullName">Loading...</strong></p>
                                <p class="mb-1" id="userAddress">Loading address...</p>
                                <p class="mb-0"><i class="bi bi-telephone me-2"></i><span id="userPhone">Loading phone...</span></p>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Go Back
                            </a>
                            <button type="submit" class="btn btn-success" id="confirmOrderBtn">
                                <i class="bi bi-check-circle"></i> Confirm & Place Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const userId = @ViewBag.UserId;
            await loadUserAddress(userId);
        });

        async function loadUserAddress(userId) {
            try {
                const response = await fetch(`/api/UserAPI/${userId}`);
                if (!response.ok) {
                    throw new Error('Failed to load user details.');
                }
                const user = await response.json();
                document.getElementById('userFullName').textContent = user.fullName || 'N/A';
                document.getElementById('userAddress').textContent = [
                    user.addressLine,
                    user.city,
                    user.state,
                    user.pincode
                ].filter(x => x).join(', ') || 'Address not set';
                document.getElementById('userPhone').textContent = user.phone || 'No phone';
            } catch (error) {
                console.error('Error loading user:', error);
                document.getElementById('shippingAddress').innerHTML = '<p class="text-danger">Failed to load shipping address. Please try again.</p>';
            }
        }

        document.getElementById('orderForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const btn = document.getElementById('confirmOrderBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

            try {
                const formData = {
                    ProductId: parseInt(document.getElementById('productId').value),
                    Quantity: parseInt(document.getElementById('quantity').value),
                    Price: parseFloat(document.getElementById('price').value),
                    UserId: parseInt(document.getElementById('UserId').value)
                };

                const response = await fetch('/AddToOrder/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        window.location.href = `/AddToOrder/Details/${result.orderId}`;
                    } else {
                        alert(result.message || 'Failed to create order.');
                    }
                } else {
                    const error = await response.json();
                    alert(error.message || 'Server error occurred.');
                }
            } catch (error) {
                alert('Error: ' + error.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });

        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }
    </script>
}