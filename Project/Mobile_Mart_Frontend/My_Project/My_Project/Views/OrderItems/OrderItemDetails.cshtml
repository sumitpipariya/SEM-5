@model My_Project.Models.OrderItemModel
@{
    ViewData["Title"] = "Order Item Details - #" + Model.OrderItemId;
}

<div class=" container-fluid px-4 py-3" >
    <!-- Premium Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="premium-breadcrumb">
            <li class="premium-breadcrumb-item">
                <a asp-controller="OrderItem" asp-action="Index" class="premium-breadcrumb-link">
                    <i class="bi bi-house-door me-2"></i>Order Items
                </a>
            </li>
            <li class="premium-breadcrumb-item active" aria-current="page">
                <i class="bi bi-chevron-right me-2"></i>Item #@Model.OrderItemId
            </li>
        </ol>
    </nav>

    <!-- Premium Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="premium-header-card">
                <div class="premium-header-bg"></div>
                <div class="premium-header-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center">
                                <div class="premium-product-icon">
                                    <i class="bi bi-basket"></i>
                                    <div class="premium-icon-glow"></div>
                                </div>
                                <div class="ms-4">
                                    <h1 class="premium-product-title">Order Item #@Model.OrderItemId</h1>
                                    <p class="premium-product-subtitle">
                                        <i class="bi bi-receipt me-1"></i>
                                        @if (Model.OrderId.HasValue)
                                        {
                                            <span>Order ID: @Model.OrderId</span>
                                        }
                                        else
                                        {
                                            <span>No Order Associated</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                            <div class="premium-action-buttons">
                                <a asp-controller="OrderItems" asp-action="AddEdit" asp-route-id="@Model.OrderItemId"
                                   class="premium-btn premium-btn-primary">
                                    <i class="bi bi-pencil-square me-2"></i>Edit Item
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="premium-header-particles">
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Left Column - Order Item Information -->
        <div class="col-lg-8">
            <!-- Premium Basic Information Card -->
            <div class="premium-card mb-4">
                <div class="premium-card-header">
                    <div class="premium-card-icon">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <h5 class="premium-card-title">Order Item Overview</h5>
                </div>
                <div class="premium-card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="premium-info-item info-primary">
                                <div class="premium-info-icon">
                                    <i class="bi bi-hash"></i>
                                </div>
                                <div class="premium-info-content">
                                    <div class="premium-info-label">Item ID</div>
                                    <div class="premium-info-value">#@Model.OrderItemId</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="premium-info-item info-success">
                                <div class="premium-info-icon">
                                    <i class="bi bi-receipt"></i>
                                </div>
                                <div class="premium-info-content">
                                    <div class="premium-info-label">Order ID</div>
                                    <div class="premium-info-value">
                                        @if (Model.OrderId.HasValue)
                                        {
                                            <span>#@Model.OrderId</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not assigned</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="premium-info-item info-warning">
                                <div class="premium-info-icon">
                                    <i class="bi bi-123"></i>
                                </div>
                                <div class="premium-info-content">
                                    <div class="premium-info-label">Quantity</div>
                                    <div class="premium-info-value">
                                        @if (Model.Quantity.HasValue)
                                        {
                                            <span class="text-primary fw-bold">@Model.Quantity @(Model.Quantity == 1 ? "item" : "items")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="premium-info-item info-info">
                                <div class="premium-info-icon">
                                    <i class="bi bi-currency-dollar"></i>
                                </div>
                                <div class="premium-info-content">
                                    <div class="premium-info-label">Unit Price</div>
                                    <div class="premium-info-value">
                                        @if (Model.Price.HasValue)
                                        {
                                            <span class="text-success fw-bold">$@Model.Price.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Premium Calculation Card -->
            <div class="premium-card mb-4">
                <div class="premium-card-header">
                    <div class="premium-card-icon">
                        <i class="bi bi-calculator-fill"></i>
                    </div>
                    <h5 class="premium-card-title">Price Calculation</h5>
                </div>
                <div class="premium-card-body">
                    @if (Model.Price.HasValue && Model.Quantity.HasValue)
                    {
                        <div class="premium-calculation-display">
                            <div class="calculation-row">
                                <span class="calculation-label">Unit Price:</span>
                                <span class="calculation-value">$@Model.Price.Value.ToString("N2")</span>
                            </div>
                            <div class="calculation-row">
                                <span class="calculation-label">Quantity:</span>
                                <span class="calculation-value">@Model.Quantity</span>
                            </div>
                            <hr class="premium-divider">
                            <div class="calculation-row total-row">
                                <span class="calculation-label">Total Amount:</span>
                                <span class="calculation-total">$@((Model.Price.Value * Model.Quantity.Value).ToString("N2"))</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="premium-empty-state">
                            <div class="premium-empty-icon">
                                <i class="bi bi-calculator"></i>
                            </div>
                            <h6 class="premium-empty-title">Calculation Not Available</h6>
                            <p class="premium-empty-message">Price or quantity information is missing.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Premium Timeline Card -->
            <div class="premium-card mb-4">
                <div class="premium-card-header">
                    <div class="premium-card-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h5 class="premium-card-title">Activity Timeline</h5>
                </div>
                <div class="premium-card-body">
                    <div class="premium-timeline">
                        @if (Model.Created.HasValue)
                        {
                            <div class="premium-timeline-item">
                                <div class="premium-timeline-marker marker-success">
                                    <i class="bi bi-plus-lg"></i>
                                </div>
                                <div class="premium-timeline-content">
                                    <h6 class="premium-timeline-title">Order Item Created</h6>
                                    <p class="premium-timeline-date">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @Model.Created.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                    </p>
                                </div>
                            </div>
                        }
                        @if (Model.Modified.HasValue)
                        {
                            <div class="premium-timeline-item">
                                <div class="premium-timeline-marker marker-primary">
                                    <i class="bi bi-pencil"></i>
                                </div>
                                <div class="premium-timeline-content">
                                    <h6 class="premium-timeline-title">Last Modified</h6>
                                    <p class="premium-timeline-date">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @Model.Modified.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Additional Information -->
        <div class="col-lg-4">
            <!-- Premium Product Information Card -->
            <div class="premium-card mb-4">
                <div class="premium-card-header">
                    <div class="premium-card-icon">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <h5 class="premium-card-title">Product Information</h5>
                </div>
                <div class="premium-card-body">
                    <div class="premium-classification-item mb-3">
                        <div class="premium-classification-content">
                            <div class="premium-classification-icon">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="premium-classification-details">
                                <div class="premium-classification-label">Product</div>
                                <div class="premium-classification-value">
                                    @if (Model.ProductId.HasValue)
                                    {
                                        @if (!string.IsNullOrEmpty(Model.ProductName))
                                        {
                                            <span>@Model.ProductName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Product ID: @Model.ProductId</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No product assigned</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Premium Owner Information Card -->
            <div class="premium-card mb-4">
                <div class="premium-card-header">
                    <div class="premium-card-icon">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <h5 class="premium-card-title">Customer Information</h5>
                </div>
                <div class="premium-card-body">
                    <div class="premium-owner-card">
                        <div class="premium-owner-avatar">
                            @if (!string.IsNullOrEmpty(Model.FullName))
                            {
                                <span class="premium-avatar-text">@Model.FullName.Substring(0, 1).ToUpper()</span>
                            }
                            else
                            {
                                <i class="bi bi-person"></i>
                            }
                            <div class="premium-avatar-glow"></div>
                        </div>
                        <div class="premium-owner-details">
                            <div class="premium-owner-label">Customer</div>
                            <div class="premium-owner-name">
                                @if (!string.IsNullOrEmpty(Model.FullName))
                                {
                                    <span>@Model.FullName</span>
                                }
                                else if (Model.UserId.HasValue)
                                {
                                    <span class="text-muted">User ID: @Model.UserId</span>
                                }
                                else
                                {
                                    <span class="text-muted">No customer assigned</span>
                                }
                            </div>
                            <div class="premium-owner-role">Customer</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Premium Quick Actions Card -->
            <div class="premium-card mb-4">
                <div class="premium-card-header">
                    <div class="premium-card-icon">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
                    <h5 class="premium-card-title">Quick Actions</h5>
                </div>
                <div class="premium-card-body">
                    <div class="premium-actions-grid">
                        <a asp-controller="OrderItems" asp-action="AddEdit" asp-route-id="@Model.OrderItemId"
                           class="premium-action-item action-primary">
                            <div class="premium-action-icon">
                                <i class="bi bi-pencil-square"></i>
                            </div>
                            <div class="premium-action-text">Edit Item</div>
                        </a>
                        @if (Model.OrderId.HasValue)
                        {
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId"
                               class="premium-action-item action-secondary">
                                <div class="premium-action-icon">
                                    <i class="bi bi-receipt"></i>
                                </div>
                                <div class="premium-action-text">View Order</div>
                            </a>
                        }
                        <button type="button" class="premium-action-item action-info" onclick="printOrderItem()">
                            <div class="premium-action-icon">
                                <i class="bi bi-printer"></i>
                            </div>
                            <div class="premium-action-text">Print</div>
                        </button>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Premium Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="premium-modal">
            <div class="premium-modal-header">
                <div class="premium-modal-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div class="premium-modal-icon-glow"></div>
                </div>
                <h5 class="premium-modal-title">Delete Order Item</h5>
                <button type="button" class="premium-modal-close" data-bs-dismiss="modal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="premium-modal-body">
                <div class="premium-modal-warning">
                    <div class="premium-warning-icon">
                        <i class="bi bi-trash"></i>
                    </div>
                    <h6 class="premium-warning-title">Are you absolutely sure?</h6>
                    <p class="premium-warning-message">
                        This action cannot be undone. This will permanently delete the order item
                        <strong id="deleteItemName"></strong> and remove all associated data.
                    </p>
                </div>
            </div>
            <div class="premium-modal-footer">
                <button type="button" class="premium-btn premium-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" class="premium-btn premium-btn-danger">
                    <i class="bi bi-trash me-2"></i>Delete Item
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-50: #f8f9fa;
        --premium-gray-100: #f1f3f4;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Premium Breadcrumb */
    .premium-breadcrumb {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius);
        padding: 1rem 1.5rem;
        margin: 0;
        box-shadow: var(--premium-shadow-sm);
        border: 1px solid var(--premium-gray-200);
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .premium-breadcrumb-item {
        display: flex;
        align-items: center;
    }

    .premium-breadcrumb-link {
        color: var(--premium-gray-600);
        text-decoration: none;
        font-weight: 500;
        transition: var(--premium-transition);
        display: flex;
        align-items: center;
    }

        .premium-breadcrumb-link:hover {
            color: #667eea;
        }

    .premium-breadcrumb-item.active {
        color: var(--premium-gray-800);
        font-weight: 600;
    }

    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        border: 1px solid var(--premium-gray-200);
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-product-icon {
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-product-title {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .premium-product-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 0;
    }

    .premium-header-particles {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: premium-float 6s ease-in-out infinite;
    }

        .particle:nth-child(1) {
            top: 20%;
            left: 20%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            top: 60%;
            left: 80%;
            animation-delay: 1s;
        }

        .particle:nth-child(3) {
            top: 80%;
            left: 40%;
            animation-delay: 2s;
        }

        .particle:nth-child(4) {
            top: 40%;
            left: 70%;
            animation-delay: 3s;
        }

        .particle:nth-child(5) {
            top: 30%;
            left: 10%;
            animation-delay: 4s;
        }

    /* Premium Buttons */
    .premium-btn {
        padding: 0.75rem 1.5rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: var(--premium-transition);
        border: none;
        cursor: pointer;
    }

    .premium-btn-primary {
        background: var(--premium-light);
        color: #667eea;
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: #5a67d8;
        }

    .premium-btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: var(--premium-light);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
    }

        .premium-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: var(--premium-light);
        }

    .premium-btn-danger {
        background: var(--premium-danger);
        color: var(--premium-light);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: var(--premium-light);
        }

    .premium-action-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Premium Cards */
    .premium-card {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        overflow: hidden;
        transition: var(--premium-transition);
    }

        .premium-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--premium-shadow-lg);
        }

    .premium-card-header {
        background: linear-gradient(135deg, var(--premium-gray-50), var(--premium-gray-100));
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--premium-gray-200);
        display: flex;
        align-items: center;
    }

    .premium-card-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--premium-border-radius);
        background: var(--premium-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--premium-light);
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .premium-card-title {
        margin: 0;
        font-weight: 700;
        color: var(--premium-gray-900);
    }

    .premium-card-body {
        padding: 2rem;
    }

    /* Premium Info Items */
    .premium-info-item {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius);
        padding: 1.5rem;
        border: 2px solid;
        transition: var(--premium-transition);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .premium-info-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow);
        }

    .info-primary {
        border-color: rgba(102, 126, 234, 0.2);
        background: rgba(102, 126, 234, 0.05);
    }

    .info-success {
        border-color: rgba(79, 172, 254, 0.2);
        background: rgba(79, 172, 254, 0.05);
    }

    .info-warning {
        border-color: rgba(67, 233, 123, 0.2);
        background: rgba(67, 233, 123, 0.05);
    }

    .info-info {
        border-color: rgba(168, 237, 234, 0.2);
        background: rgba(168, 237, 234, 0.05);
    }

    .premium-info-icon {
        width: 50px;
        height: 50px;
        border-radius: var(--premium-border-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        flex-shrink: 0;
