@model My_Project.Models.OrderItemModel
@{
    ViewData["Title"] = "Add Order Item";
}

<div class="main" id="main">
    <div class="container-fluid py-5 bg-light min-vh-100 mt-4">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <!-- Page Header -->
                <div class="text-center mb-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-info bg-gradient rounded-circle shadow mb-3"
                         style="width: 80px; height: 80px;">
                        <i class="bx bx-cart-add text-white fs-1"></i>
                    </div>
                    <h1 class="display-6 fw-bold mb-2 text-primary">Add Order Item</h1>
                    <p class="text-muted fs-5">Add a new item to an existing order</p>
                </div>

                <!-- Main Form Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <!-- Card Header -->
                    <div class="card-header bg-white border-bottom py-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="mb-0 fw-bold text-primary">Order Item Details</h4>
                                <small class="text-muted">Please fill in all required fields marked with *</small>
                            </div>
                            <div class="col-auto">
                                <a asp-controller="OrderItems" asp-action="GetAllOrderItem" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="bx bx-arrow-back me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Form Body -->
                    <div class="card-body p-5">
                        <form asp-controller="OrderItems" asp-action="AddEdit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="OrderItemId" />
                            <input type="hidden" asp-for="UserId" value="@Context.Session.GetInt32("UserID")">

                            <div class="row g-4">
                                <!-- Order Information Section -->
                                <div class="col-12">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="bg-primary bg-gradient rounded-circle p-2 me-3">
                                            <i class="bx bx-receipt text-white fs-5"></i>
                                        </div>
                                        <h5 class="mb-0 fw-bold text-warning">Order Information</h5>
                                    </div>
                                </div>

                                <!-- Order Dropdown -->
                                <div class="col-md-6">
                                    <label asp-for="OrderId" class="form-label fw-semibold text-dark">
                                        <i class="bx bx-receipt me-2 text-primary"></i>Order *
                                    </label>
                                    <select asp-for="OrderId" class="form-select form-select-lg border-0 bg-light rounded-3 shadow-sm" required>
                                        <option value="">Select Order</option>
                                        @foreach (var order in Model.Orders)
                                        {
                                            <option value="@order.OrderId">@order.OrderName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="OrderId" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Product ID -->
                                <div class="col-md-6">
                                    <label asp-for="ProductId" class="form-label fw-semibold text-dark">
                                        <i class="bx bx-package me-2 text-warning"></i>Product *
                                    </label>
                                    <select asp-for="ProductId" class="form-select form-select-lg border-0 bg-light rounded-3 shadow-sm"  required>
                                        <option value="">Select Product</option>
                                        @foreach (var product in Model.Products)
                                        {
                                            <option value="@product.ProductId" data-price="@product.Price">
                                                @product.ProductName
                                            </option>
                                        }
                                    </select>

                                    <span asp-validation-for="ProductId" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Item Details Section -->
                                <div class="col-12 mt-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="bg-success bg-gradient rounded-circle p-2 me-3">
                                            <i class="bx bx-detail text-white fs-5"></i>
                                        </div>
                                        <h5 class="mb-0 fw-bold text-warning">Item Details</h5>
                                    </div>
                                </div>

                                <!-- Quantity -->
                                <div class="col-md-4">
                                    <label asp-for="Quantity" class="form-label fw-semibold text-dark">
                                        <i class="bx bx-hash me-2 text-warning"></i>Quantity *
                                    </label>
                                    <input asp-for="Quantity" class="form-control form-control-lg border-0 bg-light rounded-3 shadow-sm"
                                           placeholder="1" type="number" min="1" max="999" onchange="calculateTotal()" />
                                    <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Unit Price -->
                                <div class="col-md-4">
                                    <label asp-for="Price" class="form-label fw-semibold text-dark">
                                        <i class="bx bx-dollar me-2 text-warning"></i>Price *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light border-0 rounded-start-3">$</span>
                                        <input asp-for="Price" class="form-control border-0 bg-light rounded-end-3 shadow-sm"
                                               placeholder="0.00" type="number" step="0.01" min="0" onchange="calculateTotal()" />
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="row mt-5">
                                <div class="col-12">
                                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                                        <button type="submit" class="btn btn-info btn-lg px-5 py-3 rounded-pill shadow fw-bold">
                                            <i class="bx bx-save me-2"></i>Add to Order
                                        </button>
                                        <button type="reset" class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-pill">
                                            <i class="bx bx-reset me-2"></i>Reset Form
                                        </button>
                                        <a asp-controller="OrderItems" asp-action="GetAllOrderItem" class="btn btn-outline-danger btn-lg px-5 py-3 rounded-pill">
                                            <i class="bx bx-x me-2"></i>Cancel
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Toast -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="successToast" class="toast border-0 shadow-lg" role="alert">
        <div class="toast-header bg-success text-white border-0">
            <i class="bx bx-check-circle me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body bg-white">
            Order item added successfully!
        </div>
    </div>
</div>

<!-- Error Toast -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="errorToast" class="toast border-0 shadow-lg" role="alert">
        <div class="toast-header bg-danger text-white border-0">
            <i class="bx bx-error-circle me-2"></i>
            <strong class="me-auto">Error</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body bg-white">
            <span id="errorMessage">Please check the form for errors and try again.</span>
        </div>
    </div>
</div>

<script>
    // Update price when product is selected
    function updatePrice() {
        const productSelect = document.querySelector('select[asp-for="ProductId"]');
        const priceInput = document.querySelector('input[asp-for="Price"]');
        const selectedOption = productSelect.options[productSelect.selectedIndex];

        if (selectedOption && selectedOption.dataset.price) {
            priceInput.value = selectedOption.dataset.price;
            calculateTotal();
        }
    }

    // Calculate total price
    function calculateTotal() {
        const quantity = document.querySelector('input[asp-for="Quantity"]').value || 0;
        const price = document.querySelector('input[asp-for="Price"]').value || 0;
        const total = (parseFloat(quantity) * parseFloat(price)).toFixed(2);
        document.getElementById('totalPrice').value = total;
    }

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');

        // Form submission handling
        form.addEventListener('submit', function(e) {
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-2"></i>Adding Item...';
            submitBtn.disabled = true;

            // Re-enable button after 5 seconds (in case of errors)
            setTimeout(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }, 5000);
        });

        // Reset form functionality
        const resetBtn = form.querySelector('button[type="reset"]');
        resetBtn.addEventListener('click', function() {
            form.reset();
            document.getElementById('totalPrice').value = '';
        });

        // Quantity validation
        const quantityInput = document.querySelector('input[asp-for="Quantity"]');
        if (quantityInput) {
            quantityInput.addEventListener('input', function() {
                if (this.value < 1) {
                    this.value = 1;
                }
                if (this.value > 999) {
                    this.value = 999;
                }
            });
        }

        // Price validation
        const priceInput = document.querySelector('input[asp-for="Price"]');
        if (priceInput) {
            priceInput.addEventListener('input', function() {
                if (this.value < 0) {
                    this.value = 0;
                }
            });
        }

        // Show success toast
    @if (TempData["Success"] != null)
    {
        <text>
                    const successToast = new bootstrap.Toast(document.getElementById('successToast'));
                    successToast.show();
        </text>
    }

        // Show error toast
    @if (TempData["Error"] != null)
    {
        <text>
                    document.getElementById('errorMessage').textContent = '@TempData["Error"]';
                    const errorToast = new bootstrap.Toast(document.getElementById('errorToast'));
                    errorToast.show();
        </text>
    }
    });
</script>
