@model List<My_Project.Models.CartModel>

@{
    Layout = "_Layout_User";
    ViewData["Title"] = "Your Cart";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
<!-- Bootstrap 5.3 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e9f2 100%);
        min-height: 100vh;
    }

    .cart-container {
        max-width: 1400px;
    }

    .section-title {
        font-weight: 700;
        letter-spacing: -0.5px;
        position: relative;
        padding-bottom: 10px;
    }

        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 60px;
            height: 4px;
            background: linear-gradient(90deg, #6a11cb, #2575fc);
            border-radius: 2px;
        }

    .cart-item {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        overflow: hidden;
    }

        .cart-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

    .product-image {
        height: 130px;
        object-fit: contain;
        transition: transform 0.4s ease;
        background-color: #fff;
        padding: 15px;
        border-radius: 12px;
    }

        .product-image:hover {
            transform: scale(1.08);
        }

    .btn-gradient-primary {
        background: linear-gradient(90deg, #6a11cb, #2575fc);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient-primary:hover {
            background: linear-gradient(90deg, #2575fc, #6a11cb);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(37, 117, 252, 0.4);
        }

    .btn-gradient-success {
        background: linear-gradient(90deg, #00b09b, #96c93d);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-gradient-success:hover {
            background: linear-gradient(90deg, #96c93d, #00b09b);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 176, 155, 0.4);
        }

    .btn-outline-danger-custom {
        border-color: #ff6b6b;
        color: #ff6b6b;
        transition: all 0.3s ease;
    }

        .btn-outline-danger-custom:hover {
            background-color: #ff6b6b;
            color: white;
            transform: translateY(-2px);
        }

    .cart-summary {
        background: #fff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        border: 1px solid #f0f0f0;
    }

        .cart-summary h5 {
            font-weight: 700;
            color: #2d3748;
        }

    .summary-item {
        font-size: 1.05rem;
        padding: 8px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

        .summary-item:last-child {
            border-bottom: none;
        }

    .empty-cart {
        padding: 60px 20px;
        text-align: center;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.05);
    }

        .empty-cart img {
            max-width: 220px;
            margin-bottom: 25px;
            filter: drop-shadow(0 5px 15px rgba(0, 0, 0, 0.1));
        }

    .qty-input {
        width: 70px !important;
        text-align: center;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 6px 4px;
        font-weight: 500;
    }

        .qty-input:focus {
            box-shadow: 0 0 0 3px rgba(106, 17, 203, 0.15);
            border-color: #6a11cb;
        }

    .product-meta {
        font-size: 0.9rem;
        color: #718096;
    }

    .price-highlight {
        font-size: 1.2rem;
        font-weight: 700;
        color: #2575fc;
    }

    @@media (max-width: 768px) {
        .product-image {
            height: 110px;
        }

        .cart-summary {
            margin-top: 30px;
        }

        .section-title::after {
            width: 40px;
        }
    }
</style>

<div class="container my-5 cart-container">
    <h2 class="mb-4 section-title text-dark">🛒 Your Shopping Cart</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger d-flex align-items-center rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@ViewBag.Error</div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                @foreach (var item in Model)
                {
                    <div class="cart-item card mb-4 rounded-4">
                        <div class="row g-0 align-items-center p-3">
                            <div class="col-4 col-md-3 text-center">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid product-image" />
                            </div>
                            <div class="col-8 col-md-9 ps-md-4">
                                <div class="d-flex flex-column h-100 justify-content-between">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">@item.ProductName</h5>
                                        <p class="product-meta mb-2">
                                            Added by: <strong>@item.FullName</strong><br />
                                            <small>@item.Created?.ToString("dd MMM yyyy, hh:mm tt")</small>
                                        </p>
                                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                            <p class="mb-0 price-highlight">₹@item.Price?.ToString("N0")</p>
                                            <div class="d-flex align-items-center">
                                                <label class="me-2 fw-medium text-nowrap">Quantity:</label>
                                                <input type="number" value="@item.Quantity" min="1"
                                                       class="form-control qty-input text-center" data-id="@item.CartId" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3 d-flex flex-wrap gap-2">
                                        <button class="btn btn-outline-danger-custom btn-sm remove-btn d-flex align-items-center" data-id="@item.CartId">
                                            <i class="bi bi-trash me-1"></i> Remove
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm flex-grow-1 flex-sm-grow-0 d-flex align-items-center">
                                            <i class="bi bi-heart me-1"></i> Save for Later
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Cart Summary -->
            <div class="col-lg-4">
                <div class="cart-summary">
                    <h5 class="mb-4">📦 Order Summary</h5>
                    <div class="summary-item d-flex justify-content-between">
                        <span>Total Items</span>
                        <strong id="total-items">@Model.Sum(x => x.Quantity ?? 0)</strong>
                    </div>
                    <div class="summary-item d-flex justify-content-between">
                        <span>Subtotal</span>
                        <strong id="subtotal">₹@Model.Sum(x => (x.Price ?? 0) * (x.Quantity ?? 0)).ToString("N0")</strong>
                    </div>
                    <div class="summary-item d-flex justify-content-between">
                        <span>Estimated Tax</span>
                        <span>₹0</span>
                    </div>
                    <div class="summary-item d-flex justify-content-between mt-3 pt-2 border-top">
                        <span class="fw-bold">Total</span>
                        <strong class="text-success fs-5" id="grand-total">₹@Model.Sum(x => (x.Price ?? 0) * (x.Quantity ?? 0)).ToString("N0")</strong>
                    </div>
                    <button class="btn btn-gradient-success w-100 fw-bold py-3 mt-4 rounded-3">
                        <i class="bi bi-credit-card me-2"></i> Proceed to Checkout
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart mt-5">
            <img src="/images/empty-cart.png" alt="Empty Cart" class="img-fluid" />
            <h4 class="fw-bold text-dark mb-2">Your cart is empty</h4>
            <p class="text-muted mb-4">Looks like you haven’t added anything yet. Start shopping now!</p>
            <a asp-controller="UserDashboard" asp-action="Index" class="btn btn-gradient-primary px-4 py-2 rounded-pill fw-semibold">
                <i class="bi bi-bag me-2"></i> Browse Products
            </a>
        </div>
    }
</div>

<!-- jQuery & Bootstrap JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {
        // Remove item with confirmation
        $('.remove-btn').click(function () {
            var cartId = $(this).data('id');
            var button = $(this);

            if (!confirm('Are you sure you want to remove this item?')) return;

            $.ajax({
                url: '/AddToCart/Remove/' + cartId,
                type: 'DELETE',
                success: function (res) {
                    button.closest('.cart-item').fadeOut(400, function () {
                        $(this).remove();
                        updateSummary();
                    });
                },
                error: function (xhr) {
                    alert('Failed to remove item. Please try again.');
                    console.error(xhr.responseText);
                }
            });
        });

        // Update quantity (optional enhancement - you can wire this to backend later)
        $('.qty-input').on('change', function () {
            updateSummary();
        });

        // Recalculate summary dynamically
        function updateSummary() {
            let totalQty = 0;
            let totalPrice = 0;

            $('.cart-item').each(function () {
                const qtyInput = $(this).find('.qty-input');
                const qty = parseInt(qtyInput.val()) || 0;
                const priceText = $(this).find('.price-highlight').text().replace('₹', '').replace(/,/g, '');
                const price = parseFloat(priceText) || 0;

                totalQty += qty;
                totalPrice += qty * price;
            });

            $('#total-items').text(totalQty);
            $('#subtotal').text('₹' + totalPrice.toLocaleString());
            $('#grand-total').text('₹' + totalPrice.toLocaleString());
        }
    });
</script>