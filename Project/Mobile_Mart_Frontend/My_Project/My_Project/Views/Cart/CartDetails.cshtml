@model My_Project.Models.CartModel
@{
    ViewData["Title"] = "Cart Details - Cart ID: " + Model.CartId;
}

<div id="main" class="main m-auto">
    <div class="container-fluid px-4 py-3">
        <!-- Premium Breadcrumb Navigation -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="premium-breadcrumb">
                <li class="premium-breadcrumb-item">
                    <a asp-controller="Cart" asp-action="Index" class="premium-breadcrumb-link">
                        <i class="bi bi-house-door me-2"></i>Carts
                    </a>
                </li>
                <li class="premium-breadcrumb-item active" aria-current="page">
                    <i class="bi bi-chevron-right me-2"></i>Cart ID: @Model.CartId
                </li>
            </ol>
        </nav>

        <!-- Premium Header Section -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="premium-header-card">
                    <div class="premium-header-bg"></div>
                    <div class="premium-header-content">
                        <div class="row align-items-center">
                            <div class="col-lg-8">
                                <div class="d-flex align-items-center">
                                    <div class="premium-category-icon">
                                        @* Using premium-category-icon for consistency *@
                                        <i class="bi bi-cart"></i>
                                        <div class="premium-icon-glow"></div>
                                    </div>
                                    <div class="ms-4">
                                        <h1 class="premium-category-title">Cart ID: @Model.CartId</h1> @* Using premium-category-title *@
                                        <p class="premium-category-subtitle">
                                            @* Using premium-category-subtitle *@
                                            <i class="bi bi-person me-1"></i>User: @(Model?.FullName ?? "N/A")
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                                <div class="premium-action-buttons">
                                    <a asp-controller="Cart" asp-action="AddEdit" asp-route-id="@Model.CartId"
                                       class="premium-btn premium-btn-primary">
                                        <i class="bi bi-pencil-square me-2"></i>Edit Cart
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="premium-header-particles">
                        <div class="particle"></div>
                        <div class="particle"></div>
                        <div class="particle"></div>
                        <div class="particle"></div>
                        <div class="particle"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="row g-4">
            <!-- Left Column - Cart Information -->
            <div class="col-lg-8">
                <!-- Cart Overview Card -->
                <div class="premium-card mb-4">
                    <div class="premium-card-header">
                        <div class="premium-card-icon">
                            <i class="bi bi-info-circle-fill"></i>
                        </div>
                        <h5 class="premium-card-title">Cart Overview</h5>
                    </div>
                    <div class="premium-card-body">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="premium-info-item info-primary">
                                    <div class="premium-info-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <div class="premium-info-content">
                                        <div class="premium-info-label">Product Name</div>
                                        <div class="premium-info-value">@(Model?.ProductName ?? "N/A")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="premium-info-item info-warning">
                                    <div class="premium-info-icon">
                                        <i class="bi bi-123"></i>
                                    </div>
                                    <div class="premium-info-content">
                                        <div class="premium-info-label">Quantity</div>
                                        <div class="premium-info-value">
                                            @if (Model.Quantity.HasValue)
                                            {
                                                <span class="text-primary fw-bold">@Model.Quantity @(Model.Quantity == 1 ? "item" : "items")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not specified</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="premium-info-item info-success">
                                    <div class="premium-info-icon">
                                        <i class="bi bi-hash"></i>
                                    </div>
                                    <div class="premium-info-content">
                                        <div class="premium-info-label">Product ID</div>
                                        <div class="premium-info-value">#@Model.ProductId</div>
                                    </div>
                                </div>
                            </div>
                            @if (Model.UserId.HasValue)
                            {
                                <div class="col-md-6">
                                    <div class="premium-info-item info-warning">
                                        <div class="premium-info-icon">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div class="premium-info-content">
                                            <div class="premium-info-label">Created By</div>
                                            <div class="premium-info-value">@Model.FullName</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <!-- Premium Timeline Card -->
                <div class="premium-card mb-4">
                    <div class="premium-card-header">
                        <div class="premium-card-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <h5 class="premium-card-title">Activity Timeline</h5>
                    </div>
                    <div class="premium-card-body">
                        <div class="premium-timeline">
                            @if (Model.Created.HasValue)
                            {
                                <div class="premium-timeline-item">
                                    <div class="premium-timeline-marker marker-success">
                                        <i class="bi bi-plus-lg"></i>
                                    </div>
                                    <div class="premium-timeline-content">
                                        <h6 class="premium-timeline-title">Category Created</h6>
                                        <p class="premium-timeline-date">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @Model.Created.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                        </p>
                                        <p class="premium-timeline-description">Cart was successfully created and assigned ID #@Model.CartId</p>
                                    </div>
                                </div>
                            }
                            @if (Model.Modified.HasValue && Model.Modified != Model.Created)
                            {
                                <div class="premium-timeline-item">
                                    <div class="premium-timeline-marker marker-primary">
                                        <i class="bi bi-pencil"></i>
                                    </div>
                                    <div class="premium-timeline-content">
                                        <h6 class="premium-timeline-title">Category Modified</h6>
                                        <p class="premium-timeline-date">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @Model.Modified.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                        </p>
                                        <p class="premium-timeline-description">Category details were updated and changes were saved</p>
                                    </div>
                                </div>
                            }
                            <div class="premium-timeline-item">
                                <div class="premium-timeline-marker marker-info">
                                    <i class="bi bi-eye"></i>
                                </div>
                                <div class="premium-timeline-content">
                                    <h6 class="premium-timeline-title">Currently Viewing</h6>
                                    <p class="premium-timeline-date">
                                        <i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                                    </p>
                                    <p class="premium-timeline-description">You are currently viewing the details of this cart</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Right Column - Additional Information -->
            <div class="col-lg-4">
                <!-- Premium Creator Information Card -->
                @if (Model.UserId.HasValue)
                {
                    <div class="premium-card mb-4">
                        <div class="premium-card-header">
                            <div class="premium-card-icon">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <h5 class="premium-card-title">Creator Information</h5>
                        </div>
                        <div class="premium-card-body">
                            <div class="premium-creator-card">
                                <div class="premium-creator-avatar">
                                    <span class="premium-avatar-text">U</span>
                                    <div class="premium-avatar-glow"></div>
                                </div>
                                <div class="premium-creator-details">
                                    <div class="premium-creator-label">Created By</div>
                                    <div class="premium-creator-name">@Model.FullName</div>
                                    <div class="premium-creator-role">Category Manager</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <a href="@Url.Action("UserDetails", "User", new { id = Model.UserId })"
                                   class="premium-btn premium-btn-outline w-100">
                                    <i class="bi bi-person-circle me-2"></i>View User Profile
                                </a>
                            </div>
                        </div>
                    </div>
                }
                <!-- Quick Actions Card -->
                <div class="premium-card mb-4">
                    <div class="premium-card-header">
                        <div class="premium-card-icon">
                            <i class="bi bi-lightning-fill"></i>
                        </div>
                        <h5 class="premium-card-title">Quick Actions</h5>
                    </div>
                    <div class="premium-card-body">
                        <div class="premium-actions-grid">
                            <a asp-controller="Cart" asp-action="AddEdit" asp-route-id="@Model.CartId"
                               class="premium-action-item action-primary">
                                <div class="premium-action-icon">
                                    <i class="bi bi-pencil-square"></i>
                                </div>
                                <div class="premium-action-text">Edit Cart</div>
                            </a>
                            <button type="button" class="premium-action-item action-danger" onclick="confirmDelete('@Model.CartId', '@(Model.Product?.ProductName ?? "N/A")')">
                                <div class="premium-action-icon">
                                    <i class="bi bi-trash"></i>
                                </div>
                                <div class="premium-action-text">Delete Cart</div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                @* Use modal-content for Bootstrap styling *@
                <div class="premium-modal">
                    @* Wrap content in premium-modal for custom styling *@
                    <div class="premium-modal-header">
                        <div class="premium-modal-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div class="premium-icon-glow"></div> @* Add glow effect *@
                        </div>
                        <h5 class="premium-modal-title">Delete Cart</h5>
                        <button type="button" class="premium-modal-close" data-bs-dismiss="modal">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                    <div class="premium-modal-body">
                        <div class="premium-modal-warning">
                            <div class="premium-warning-icon">
                                <i class="bi bi-trash"></i>
                            </div>
                            <h6 class="premium-warning-title">Are you sure?</h6>
                            <p class="premium-warning-message">
                                This action cannot be undone. This will permanently delete the cart for product
                                <strong id="deleteCartProductName"></strong> and remove all associated data.
                            </p>
                        </div>
                    </div>
                    <div class="premium-modal-footer">
                        <button type="button" class="premium-btn premium-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form id="deleteForm" asp-controller="Cart" asp-action="Delete" method="post" style="display:inline;">
                            <input type="hidden" name="id" id="deleteCartId" />
                            <button type="submit" class="premium-btn premium-btn-danger">
                                <i class="bi bi-trash me-2"></i>Delete Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-50: #f8f9fa;
        --premium-gray-100: #f1f3f4;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* Premium Breadcrumb */
    .premium-breadcrumb {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius);
        padding: 1rem 1.5rem;
        margin: 0;
        box-shadow: var(--premium-shadow-sm);
        border: 1px solid var(--premium-gray-200);
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .premium-breadcrumb-item {
        display: flex;
        align-items: center;
    }

    .premium-breadcrumb-link {
        color: var(--premium-gray-600);
        text-decoration: none;
        font-weight: 500;
        transition: var(--premium-transition);
        display: flex;
        align-items: center;
    }

        .premium-breadcrumb-link:hover {
            color: #667eea;
        }

    .premium-breadcrumb-item.active {
        color: var(--premium-gray-800);
        font-weight: 600;
    }
    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        border: 1px solid var(--premium-gray-200);
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-category-icon { /* Re-using category icon style for product/cart header */
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-category-title { /* Re-using category title style */
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .premium-category-subtitle { /* Re-using category subtitle style */
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 0;
    }

    .premium-header-particles {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: premium-float 6s ease-in-out infinite;
    }

        .particle:nth-child(1) {
            top: 20%;
            left: 20%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            top: 60%;
            left: 80%;
            animation-delay: 1s;
        }

        .particle:nth-child(3) {
            top: 80%;
            left: 40%;
            animation-delay: 2s;
        }

        .particle:nth-child(4) {
            top: 40%;
            left: 70%;
            animation-delay: 3s;
        }

        .particle:nth-child(5) {
            top: 30%;
            left: 10%;
            animation-delay: 4s;
        }
    /* Premium Cards */
    .premium-card {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        overflow: hidden;
        transition: var(--premium-transition);
    }

        .premium-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--premium-shadow-lg);
        }

    .premium-card-header {
        background: linear-gradient(135deg, var(--premium-gray-50), var(--premium-gray-100));
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--premium-gray-200);
        display: flex;
        align-items: center;
    }

    .premium-card-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--premium-border-radius);
        background: var(--premium-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--premium-light);
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .premium-card-title {
        margin: 0;
        font-weight: 700;
        color: var(--premium-gray-900);
    }

    .premium-card-body {
        padding: 2rem;
    }
    /* Premium Creator Card */
    .premium-creator-card {
        background: rgba(102, 126, 234, 0.05);
        border-radius: var(--premium-border-radius);
        padding: 2rem;
        border: 1px solid rgba(102, 126, 234, 0.2);
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .premium-creator-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--premium-primary);
        color: var(--premium-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }

    .premium-avatar-text {
        position: relative;
        z-index: 2;
    }

    .premium-avatar-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-creator-label {
        font-size: 0.875rem;
        color: var(--premium-gray-600);
        margin-bottom: 0.25rem;
        font-weight: 500;
    }

    .premium-creator-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--premium-gray-900);
        margin-bottom: 0.25rem;
    }

    .premium-creator-role {
        font-size: 0.875rem;
        color: var(--premium-gray-600);
    }
    /* Premium Timeline */
    .premium-timeline {
        position: relative;
    }

    .premium-timeline-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 2rem;
        position: relative;
    }

        .premium-timeline-item:last-child {
            margin-bottom: 0;
        }

        .premium-timeline-item:not(:last-child)::after {
            content: '';
            position: absolute;
            left: 20px;
            top: 40px;
            bottom: -2rem;
            width: 2px;
            background: var(--premium-gray-200);
        }

    .premium-timeline-marker {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--premium-light);
        font-size: 1rem;
        margin-right: 1rem;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .marker-success {
        background: var(--premium-success);
    }

    .marker-primary {
        background: var(--premium-primary);
    }

    .marker-info {
        background: var(--premium-info);
    }

    .premium-timeline-title {
        font-weight: 700;
        color: var(--premium-gray-900);
        margin-bottom: 0.5rem;
    }

    .premium-timeline-date {
        color: var(--premium-gray-600);
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
    }

    .premium-timeline-description {
        color: var(--premium-gray-700);
        font-size: 0.9rem;
        margin: 0;
        line-height: 1.5;
    }

    /* Premium Buttons */
    .premium-btn {
        padding: 0.75rem 1.5rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: var(--premium-transition);
        border: none;
        cursor: pointer;
    }

    .premium-btn-sm {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
    }

    .premium-btn-primary {
        background: var(--premium-light);
        color: #667eea;
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: #5a67d8;
        }

    .premium-btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: var(--premium-light);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
    }

        .premium-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: var(--premium-light);
        }

    .premium-btn-outline {
        background: transparent;
        color: #667eea;
        border: 2px solid #667eea;
    }

        .premium-btn-outline:hover {
            background: #667eea;
            color: var(--premium-light);
            transform: translateY(-2px);
        }

    .premium-btn-danger {
        background: var(--premium-danger);
        color: var(--premium-light);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
