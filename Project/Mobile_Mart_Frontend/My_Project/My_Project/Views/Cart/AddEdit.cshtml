@model My_Project.Models.CartModel
@{
    ViewData["Title"] = "Add Cart Item";
   
}

<div class="main" id="main">
    <div class="container-fluid py-5 bg-light min-vh-100 mt-4">
        <div class="row justify-content-center">
            <div class="col-xl-8 col-lg-10">
                <!-- Page Header -->
                <div class="text-center mb-5">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-gradient rounded-circle shadow mb-3"
                         style="width: 80px; height: 80px;">
                        <i class="bx bx-cart text-white fs-1"></i>
                    </div>
                    <h1 class="display-6 fw-bold mb-2 text-primary">Add Item to Cart</h1>
                    <p class="text-muted fs-5">Add a new product to a user's shopping cart</p>
                </div>

                <!-- Main Form Card -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                    <!-- Card Header -->
                    <div class="card-header bg-white border-bottom py-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="mb-0 fw-bold text-primary">Cart Item Details</h4>
                                <small class="text-muted">Please fill in all required fields marked with *</small>
                            </div>
                            <div class="col-auto">
                                <a asp-controller="Cart" asp-action="GetAllCarts" class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="bx bx-arrow-back me-2"></i>Back to List
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Form Body -->
                    <div class="card-body p-5">
                        <form asp-controller="Cart" asp-action="AddEdit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="CartId" />
                            <input type="hidden" asp-for="UserId" value="@Context.Session.GetInt32("UserID")">
                                 
                            <div class="row g-4">

                                <!-- Product Information Section -->
                                <div class="col-12 mt-5">
                                    <div class="d-flex align-items-center mb-4">
                                        <div class="bg-info bg-gradient rounded-circle p-2 me-3">
                                            <i class="bx bx-package text-white fs-5"></i>
                                        </div>
                                        <h5 class="mb-0 fw-bold text-warning">Product Details</h5>
                                    </div>
                                </div>

                                <!-- Product ID -->
                                <div class="col-md-6">
                                    <label asp-for="ProductId" class="form-label fw-semibold text-dark">
                                        <i class="bx bx-package me-2 text-warning"></i>Product *
                                    </label>
                                    <select asp-for="ProductId" class="form-select form-select-lg border-0 bg-light rounded-3 shadow-sm"
                                            asp-items="@(new SelectList(Model?.Products ?? new List<ProductModel>(), "ProductId", "ProductName"))"
                                            onchange="updateProductName()">
                                        <option value="">Select Product</option>
                                    </select>
                                    <span asp-validation-for="ProductId" class="text-danger small mt-1 d-block"></span>
                                </div>


                                <!-- Quantity -->
                                <div class="col-md-6">
                                    <label asp-for="Quantity" class="form-label fw-semibold text-dark">
                                        <i class="bx bx-hash me-2 text-warning"></i>Quantity *
                                    </label>
                                    <input asp-for="Quantity" class="form-control form-control-lg border-0 bg-light rounded-3 shadow-sm"
                                           placeholder="1" type="number" min="1" max="999" />
                                    <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="row mt-5">
                                <div class="col-12">
                                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                                        <button type="submit" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow fw-bold">
                                            <i class="bx bx-cart-add me-2"></i>Add to Cart
                                        </button>
                                        <button type="reset" class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-pill">
                                            <i class="bx bx-reset me-2"></i>Reset Form
                                        </button>
                                        <a asp-controller="Cart" asp-action="GetAllCarts" class="btn btn-outline-danger btn-lg px-5 py-3 rounded-pill">
                                            <i class="bx bx-x me-2"></i>Cancel
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Toast -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="successToast" class="toast border-0 shadow-lg" role="alert">
        <div class="toast-header bg-success text-white border-0">
            <i class="bx bx-check-circle me-2"></i>
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body bg-white">
            Item added to cart successfully!
        </div>
    </div>
</div>

<!-- Error Toast -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="errorToast" class="toast border-0 shadow-lg" role="alert">
        <div class="toast-header bg-danger text-white border-0">
            <i class="bx bx-error-circle me-2"></i>
            <strong class="me-auto">Error</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body bg-white">
            <span id="errorMessage">Please check the form for errors and try again.</span>
        </div>
    </div>
</div>

<script>
    // Update customer name when customer is selected
    function updateCustomerName() {
        const customerSelect = document.querySelector('select[asp-for="UserId"]');
        const fullNameInput = document.querySelector('input[asp-for="FullName"]');
        const selectedOption = customerSelect.options[customerSelect.selectedIndex];

        if (selectedOption && selectedOption.value) {
            // Assuming the text of the option is the full name
            fullNameInput.value = selectedOption.text;
        } else {
            fullNameInput.value = '';
        }
    }

    // Update product name when product is selected
    function updateProductName() {
        const productSelect = document.querySelector('select[asp-for="ProductId"]');
        const productNameInput = document.querySelector('input[asp-for="ProductName"]');
        const selectedOption = productSelect.options[productSelect.selectedIndex];

        if (selectedOption && selectedOption.value) {
            // Assuming the text of the option is the product name
            productNameInput.value = selectedOption.text;
        } else {
            productNameInput.value = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');

        // Form submission handling
        form.addEventListener('submit', function(e) {
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-2"></i>Adding Item...';
            submitBtn.disabled = true;

            // Re-enable button after 5 seconds (in case of errors)
            setTimeout(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }, 5000);
        });

        // Reset form functionality
        const resetBtn = form.querySelector('button[type="reset"]');
        resetBtn.addEventListener('click', function() {
            form.reset();
            // Clear auto-populated fields on reset
            document.querySelector('input[asp-for="FullName"]').value = '';
            document.querySelector('input[asp-for="ProductName"]').value = '';
        });

        // Quantity validation
        const quantityInput = document.querySelector('input[asp-for="Quantity"]');
        if (quantityInput) {
            quantityInput.addEventListener('input', function() {
                if (this.value < 1) {
                    this.value = 1;
                }
                if (this.value > 999) {
                    this.value = 999;
                }
            });
        }

        // Initialize auto-populated fields if values are already set (e.g., on edit)
        updateCustomerName();
        updateProductName();

        // Show success toast
    @if (TempData["Success"] != null)
    {
        <text>
                    const successToast = new bootstrap.Toast(document.getElementById('successToast'));
                    successToast.show();
        </text>
    }

        // Show error toast
    @if (TempData["Error"] != null)
    {
        <text>
                    document.getElementById('errorMessage').textContent = '@TempData["Error"]';
                    const errorToast = new bootstrap.Toast(document.getElementById('errorToast'));
                    errorToast.show();
        </text>
    }
    });
</script>
