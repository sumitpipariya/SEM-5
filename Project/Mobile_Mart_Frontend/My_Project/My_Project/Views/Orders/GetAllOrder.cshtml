@model List<My_Project.Models.OrderModel>
@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid ">
    <!-- Premium Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="premium-header-card">
                <div class="premium-header-bg"></div>
                <div class="premium-header-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center mb-4">
                                <div class="premium-icon-wrapper">
                                    <i class="bx bx-receipt"></i>
                                    <div class="premium-icon-glow"></div>
                                </div>
                                <div class="ms-4">
                                    <h1 class="premium-title">Order Management</h1>
                                    <p class="premium-subtitle">Advanced order tracking with real-time analytics and insights</p>
                                </div>
                            </div>
                         
                        </div>
                        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                            <div class="premium-action-buttons">
                                <a asp-controller="Orders" asp-action="AddEdit" class="btn premium-btn-primary">
                                    <i class="bx bx-plus-circle me-2"></i>
                                    Create Order
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="premium-header-particles">
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-primary">
                <div class="premium-stats-icon">
                    <i class="bx bx-receipt"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Total Orders</div>
                    <div class="premium-stats-value">@(Model?.Count ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bx bx-trending-up"></i>
                        <span>+18% from last month</span>
                    </div>
                </div>
                <div class="premium-stats-chart">
                    <div class="chart-bar" style="height: 70%"></div>
                    <div class="chart-bar" style="height: 85%"></div>
                    <div class="chart-bar" style="height: 60%"></div>
                    <div class="chart-bar" style="height: 95%"></div>
                    <div class="chart-bar" style="height: 80%"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-success">
                <div class="premium-stats-icon">
                    <i class="bx bx-check-circle"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Completed Orders</div>
                    <div class="premium-stats-value">@(Model?.Where(o => o.Status == "Completed").Count() ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bx bx-check-circle"></i>
                        <span>Excellent delivery</span>
                    </div>
                </div>
                <div class="premium-stats-progress">
                    <div class="progress-ring">
                        <div class="progress-circle" data-percentage="85"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-warning">
                <div class="premium-stats-icon">
                    <i class="bx bx-time"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Pending Orders</div>
                    <div class="premium-stats-value">@(Model?.Where(o => o.Status == "Pending").Count() ?? 0)</div>
                    <div class="premium-stats-change neutral">
                        <i class="bx bx-hourglass"></i>
                        <span>In processing</span>
                    </div>
                </div>
                <div class="premium-stats-wave">
                    <svg viewBox="0 0 100 20">
                        <path d="M0,10 Q25,0 50,10 T100,10" stroke="currentColor" fill="none" stroke-width="2" />
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-info">
                <div class="premium-stats-icon">
                    <i class="bx bx-rupee"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Total Revenue</div>
                    <div class="premium-stats-value">₹@(Model?.Sum(o => o.TotalAmount)?.ToString("N0") ?? "0")</div>
                    <div class="premium-stats-change positive">
                        <i class="bx bx-trending-up"></i>
                        <span>Strong growth</span>
                    </div>
                </div>
                <div class="premium-stats-dots">
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="premium-alert alert-danger">
            <div class="premium-alert-icon">
                <i class="bx bx-error-circle"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Error!</div>
                <div class="premium-alert-message">@TempData["Error"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bx bx-x"></i>
            </button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="premium-alert alert-success">
            <div class="premium-alert-icon">
                <i class="bx bx-check-circle"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Success!</div>
                <div class="premium-alert-message">@TempData["Success"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bx bx-x"></i>
            </button>
        </div>
    }

    <!-- Premium Search Panel -->
    <div class="premium-search-panel mb-4">
        <div class="premium-search-header">
            <div class="d-flex align-items-center">
                <div class="premium-search-icon">
                    <i class="bx bx-filter-alt"></i>
                </div>
                <h5 class="premium-search-title">Advanced Search & Filters</h5>
            </div>
            <button class="premium-toggle-btn" data-bs-toggle="collapse" data-bs-target="#searchPanel">
                <i class="bx bx-chevron-down"></i>
            </button>
        </div>
        <div class="collapse show" id="searchPanel">
            <div class="premium-search-content">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Search Orders</label>
                            <div class="premium-input-wrapper">
                                <i class="bx bx-search premium-input-icon"></i>
                                <input type="text" id="searchInput" class="premium-form-control"
                                       placeholder="Search by order ID, user ID...">
                                <div class="premium-input-focus"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Status</label>
                            <div class="premium-select-wrapper">
                                <select id="statusFilter" class="premium-form-select">
                                    <option value="">All Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Processing">Processing</option>
                                    <option value="Shipped">Shipped</option>
                                    <option value="Delivered">Delivered</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                                <i class="bx bx-chevron-down premium-select-icon"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Date Range</label>
                            <div class="premium-select-wrapper">
                                <select id="dateFilter" class="premium-form-select">
                                    <option value="">All Dates</option>
                                    <option value="today">Today</option>
                                    <option value="week">This Week</option>
                                    <option value="month">This Month</option>
                                    <option value="quarter">This Quarter</option>
                                </select>
                                <i class="bx bx-chevron-down premium-select-icon"></i>
                            </div>
                        </div>
                    </div>
                   
                    <div class="col-lg-2 col-md-12">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Actions</label>
                            <div class="d-flex gap-2">
                                <button type="button" class="premium-action-btn" onclick="clearFilters()" data-bs-toggle="tooltip" title="Clear filters">
                                    <i class="bx bx-refresh"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Orders Table -->
    <div class="premium-table-container">
        <div class="premium-table-header">
            <div class="d-flex align-items-center">
                <div class="premium-table-icon">
                    <i class="bx bx-table"></i>
                </div>
                <div>
                    <h5 class="premium-table-title">Order Directory</h5>
                    <span class="premium-table-badge" id="totalCount">@(Model?.Count ?? 0) orders</span>
                </div>
            </div>
            <div class="premium-table-controls" style="margin-left:auto">             
                <button class="premium-refresh-btn" onclick="refreshTable()">
                    <i class="bx bx-refresh"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <div class="premium-table-wrapper">
            <table class="premium-table" id="ordersTable">
                <thead>
                    <tr>
                        <th class="premium-th sortable" data-column="orderid">
                            <div class="premium-th-content">
                                <i class="bx bx-hash"></i>
                                <span>Order ID</span>
                                <i class="bx bx-chevrons-up sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="userid">
                            <div class="premium-th-content">
                                <i class="bx bx-user"></i>
                                <span>User </span>
                                <i class="bx bx-chevrons-up sort-icon"></i>
                            </div>
                        </th>
                      
                        <th class="premium-th sortable" data-column="total">
                            <div class="premium-th-content">
                                <i class="bx bx-rupee"></i>
                                <span>Total Amount</span>
                                <i class="bx bx-chevrons-up sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="status">
                            <div class="premium-th-content">
                                <i class="bx bx-flag"></i>
                                <span>Status</span>
                                <i class="bx bx-chevrons-up sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th text-center">
                            <div class="premium-th-content justify-content-center">
                                <i class="bx bx-cog"></i>
                                <span>Actions</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="orderTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr class="premium-tr" data-order-id="@order.OrderId"
                                data-user-id="@order.UserId"
                                data-full-name="@(order.FullName?.ToLower() ?? "")"
                                data-order-date="@order.OrderDate?.ToString("yyyy-MM-dd")"
                                data-modified="@order.Modified?.ToString("yyyy-MM-dd")"
                                data-status="@(order.Status ?? "")"
                                data-total="@order.TotalAmount">
                                <td class="premium-td">
                                    <span class="premium-id-badge">#ORD-@order.OrderId</span>
                                </td>
                                <td class="premium-td">
                                    <div class="premium-user-info">
                                        <div class="premium-user-avatar">
                                            <span>@(order.UserId?.ToString().Substring(0, 1) ?? "U")</span>
                                            <div class="premium-avatar-glow"></div>
                                        </div>
                                        <div class="premium-user-details">
                                            <div class="premium-user-id">@order.FullName</div>
                                        </div>
                                    </div>
                                </td>
                             
                                <td class="premium-td">
                                    <div class="premium-amount-info">
                                        <div class="premium-amount-main">₹@(order.TotalAmount?.ToString("N2") ?? "0.00")</div>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    @{
                                        var statusClass = order.Status?.ToLower() switch
                                        {
                                            "completed" => "badge-success",
                                            "delivered" => "badge-success",
                                            "shipped" => "badge-info",
                                            "processing" => "badge-warning",
                                            "pending" => "badge-warning",
                                            "cancelled" => "badge-danger",
                                            _ => "badge-secondary"
                                        };
                                        var statusIcon = order.Status?.ToLower() switch
                                        {
                                            "completed" => "bx-check-circle",
                                            "delivered" => "bx-package",
                                            "shipped" => "bx-car",
                                            "processing" => "bx-loader-alt",
                                            "pending" => "bx-time",
                                            "cancelled" => "bx-x-circle",
                                            _ => "bx-help-circle"
                                        };
                                    }
                                    <span class="premium-badge @statusClass">
                                        <i class="bx @statusIcon"></i>
                                        @(order.Status ?? "Unknown")
                                    </span>
                                </td>
                                <td class="premium-td text-center">
                                    <div class="premium-action-group">
                                        <a asp-controller="Orders" asp-action="OrderDetails" asp-route-id="@order.OrderId"
                                           class="premium-action-btn action-view" data-bs-toggle="tooltip" title="View Details">
                                            <i class="bx bx-show"></i>
                                        </a>
                                        <a asp-controller="Orders" asp-action="AddEdit" asp-route-id="@order.OrderId"
                                           class="premium-action-btn action-edit" data-bs-toggle="tooltip" title="Edit Order">
                                            <i class="bx bx-edit-alt"></i>
                                        </a>
                                        <button type="button" class="premium-action-btn action-delete"
                                                onclick="confirmDelete('@order.OrderId')"
                                                data-bs-toggle="tooltip" title="Delete OrderItem">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noOrdersRow">
                            <td colspan="7" class="premium-empty-state">
                                <div class="premium-empty-content">
                                    <div class="premium-empty-icon">
                                        <i class="bx bx-receipt"></i>
                                        <div class="premium-empty-glow"></div>
                                    </div>
                                    <h5 class="premium-empty-title">No orders found</h5>
                                    <p class="premium-empty-message">Get started by creating your first order in the system.</p>
                                    <a asp-controller="Order" asp-action="Create" class="premium-btn-primary">
                                        <i class="bx bx-plus-circle me-2"></i>Create Your First Order
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        
    </div>
</div>

<!-- Premium Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title">
                    <i class="bx bx-trash text-danger me-2 fs-4"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center px-4">
                <i class="bx bx-error-circle text-danger display-1"></i>
                <h6 class="mt-3 fw-bold">Are you absolutely sure?</h6>
                <p class="text-muted">
                    This action cannot be undone. This will permanently delete the Order 
                    and remove all associated data.
                </p>
            </div>

            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" class="btn btn-danger px-4">
                    <i class="bx bx-trash me-1"></i>Delete Order Item
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-100: #f8f9fa;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-icon-wrapper {
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-title {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .premium-subtitle {
        font-size: 1.25rem;
        opacity: 0.9;
        font-weight: 300;
        margin-bottom: 0;
    }

    .premium-stat-item {
        text-align: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.1);
        border-radius: var(--premium-border-radius);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: var(--premium-transition);
    }

        .premium-stat-item:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.15);
        }

    .premium-stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: var(--premium-light);
    }

    .premium-stat-label {
        font-size: 0.875rem;
        opacity: 0.8;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .premium-stat-trend {
        font-size: 0.75rem;
        opacity: 0.7;
        font-weight: 500;
    }

    .premium-header-particles {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: premium-float 6s ease-in-out infinite;
    }

        .particle:nth-child(1) {
            top: 20%;
            left: 20%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            top: 60%;
            left: 80%;
            animation-delay: 1s;
        }

        .particle:nth-child(3) {
            top: 80%;
            left: 40%;
            animation-delay: 2s;
        }

        .particle:nth-child(4) {
            top: 40%;
            left: 70%;
            animation-delay: 3s;
        }

        .particle:nth-child(5) {
            top: 30%;
            left: 10%;
            animation-delay: 4s;
        }

    /* Premium Buttons */
    .premium-btn-primary {
        background: var(--premium-light);
        color: #667eea;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: var(--premium-transition);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: #5a67d8;
        }

    .premium-btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: var(--premium-light);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 0.75rem 1rem;
        border-radius: var(--premium-border-radius);
        transition: var(--premium-transition);
        backdrop-filter: blur(10px);
    }

        .premium-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: var(--premium-light);
        }

    .premium-btn-danger {
        background: var(--premium-danger);
        color: var(--premium-light);
        border: none;
        padding: 0.75rem 2rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: var(--premium-transition);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
