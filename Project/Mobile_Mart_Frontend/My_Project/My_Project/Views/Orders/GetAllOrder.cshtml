</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Animate counter numbers
        function animateCounters() {
            const counters = document.querySelectorAll('[data-count]');
            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-count'));
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;

                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        counter.textContent = target;
                        clearInterval(timer);
                    } else {
                        counter.textContent = Math.floor(current);
                    }
                }, 16);
            });
        }

        // Start counter animation after a short delay
        setTimeout(animateCounters, 500);

        // Search and filter functionality
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const dateFilter = document.getElementById('dateFilter');
        const tableBody = document.getElementById('orderTableBody');
        const totalCount = document.getElementById('totalCount');

        //Filter table
            function filterTable() {
                const searchTerm = (searchInput.value || '').toLowerCase().trim();
                const selectedStatus = statusFilter.value;
                const selectedDate = dateFilter.value;
                const rows = tableBody.querySelectorAll('.premium-tr');
                let visibleCount = 0;

                rows.forEach(row => {
                    const orderId = row.dataset.orderId?.toLowerCase() || '';
                    const userId = row.dataset.userId?.toLowerCase() || '';
                    const fullName = row.dataset.fullName || '';
                    const status = row.dataset.status || '';
                    const orderDate = row.dataset.orderDate || '';

                    // Search across Order ID, User ID, and Full Name
                    const matchesSearch = searchTerm === '' ||
                        orderId.includes(searchTerm) ||
                        userId.includes(searchTerm) ||
                        fullName.includes(searchTerm);

                    const matchesStatus = !selectedStatus || status === selectedStatus;
                    const matchesDate = !selectedDate || checkDateFilter(orderDate, selectedDate);

                    if (matchesSearch && matchesStatus && matchesDate) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                totalCount.textContent = `${visibleCount} orders`;

                // Update pagination info (if you have pagination later)
                const paginationInfo = document.getElementById('paginationInfo');
                if (paginationInfo) {
                    paginationInfo.innerHTML = `Showing <strong>1</strong> to <strong>${visibleCount}</strong> of <strong>${visibleCount}</strong> entries`;
                }

                // Handle "No Results" message
                const noResultsRow = document.getElementById('noResultsRow');
                const noOrdersRow = document.getElementById('noOrdersRow');

                // Hide permanent "no orders" row if we have data but no matches
                if (noOrdersRow) {
                    noOrdersRow.style.display = visibleCount === 0 && @(Model?.Count ?? 0) === 0 ? '' : 'none';
                }

                // Show or create temporary "no results" row if we have data but no matches
                if (visibleCount === 0 && @(Model?.Count ?? 0) > 0) {
                    if (!noResultsRow) {
                        // Dynamically create "no results" row if it doesn't exist
                        const newRow = document.createElement('tr');
                        newRow.id = 'noResultsRow';
                        newRow.innerHTML = `
                            <td colspan="7" class="premium-empty-state">
                                <div class="premium-empty-content">
                                    <div class="premium-empty-icon">
                                        <i class="bx bx-search"></i>
                                        <div class="premium-empty-glow"></div>
                                    </div>
                                    <h5 class="premium-empty-title">No matching orders</h5>
                                    <p class="premium-empty-message">Try adjusting your search or filter criteria.</p>
                                </div>
                            </td>`;
                        tableBody.appendChild(newRow);
                    } else {
                        noResultsRow.style.display = '';
                    }
                } else if (noResultsRow) {
                    // Hide the "no results" row if there are matches
                    noResultsRow.style.display = 'none';
                }
            }


        function checkDateFilter(dateString, filter) {
            if (!dateString) return true;

            const orderDate = new Date(dateString);
            const today = new Date();

            switch (filter) {
                case 'today':
                    return orderDate.toDateString() === today.toDateString();
                case 'week':
                    const weekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
                    return orderDate >= weekAgo;
                case 'month':
                    return orderDate.getMonth() === today.getMonth() && orderDate.getFullYear() === today.getFullYear();
                case 'quarter':
                    const currentQuarter = Math.floor(today.getMonth() / 3);
                    const orderQuarter = Math.floor(orderDate.getMonth() / 3);
                    return orderQuarter === currentQuarter && orderDate.getFullYear() === today.getFullYear();
                default:
                    return true;
            }
        }

            let searchTimeout;
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(filterTable, 300); // Wait 300ms after typing stops
        });
    }
        if (statusFilter) statusFilter.addEventListener('change', filterTable);
        if (dateFilter) dateFilter.addEventListener('change', filterTable);

        // Enhanced sorting functionality
        document.querySelectorAll('.sortable').forEach(header => {
            header.addEventListener('click', function () {
                const column = this.dataset.column;
                const rows = Array.from(tableBody.querySelectorAll('.premium-tr'));
                const isAscending = !this.classList.contains('sorted-asc');

                // Remove sort classes from all headers
                document.querySelectorAll('.sortable').forEach(h => {
                    h.classList.remove('sorted-asc', 'sorted-desc');
                });

                // Add sort class to current header
                this.classList.add(isAscending ? 'sorted-asc' : 'sorted-desc');

                rows.sort((a, b) => {
                    let aVal = '';
                    let bVal = '';

                    switch (column) {
                        case 'orderid':
                            aVal = a.dataset.orderId || '';
                            bVal = b.dataset.orderId || '';
                            break;
                        case 'userid':
                            aVal = a.dataset.userId || '';
                            bVal = b.dataset.userId || '';
                            break;
                        case 'orderdate':
                            aVal = a.dataset.orderDate || '';
                            bVal = b.dataset.orderDate || '';
                            break;
                        case 'modified':
                            aVal = a.dataset.modified || '';
                            bVal = b.dataset.modified || '';
                            break;
                        case 'status':
                            aVal = a.dataset.status || '';
                            bVal = b.dataset.status || '';
                            break;
                        case 'total':
                            aVal = parseFloat(a.dataset.total) || 0;
                            bVal = parseFloat(b.dataset.total) || 0;
                            return isAscending ? aVal - bVal : bVal - aVal;
                    }

                    if (isAscending) {
                        return aVal.localeCompare(bVal, undefined, { numeric: true });
                    } else {
                        return bVal.localeCompare(aVal, undefined, { numeric: true });
                    }
                });

                rows.forEach(row => tableBody.appendChild(row));
            });
        });

        // Smooth scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all cards for animation
        document.querySelectorAll('.premium-stats-card, .premium-search-panel, .premium-table-container').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    });


          function confirmDelete(orderItemId) {

           // Set confirm delete link
           document.getElementById('confirmDeleteBtn').href = `/Orders/Delete/${orderItemId}`;

           // Show modal
           var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
           deleteModal.show();
       }

    function printOrder(orderId) {
        // Add print functionality
        window.open(`/Order/Print/${orderId}`, '_blank');
    }

    function refreshTable() {
        // Add loading animation
        const refreshBtn = document.querySelector('.premium-refresh-btn');
        const originalContent = refreshBtn.innerHTML;
        refreshBtn.innerHTML = '<i class="bx bx-refresh" style="animation: spin 1s linear infinite;"></i> <span>Refreshing...</span>';

        setTimeout(() => {
            location.reload();
        }, 1000);
    }
    function clearFilters() {
        if (searchInput) searchInput.value = '';
        if (statusFilter) statusFilter.value = '';
        if (dateFilter) dateFilter.value = '';
        filterTable(); // Re-apply filters (now empty)
    }

    function exportOrders() {
        // Show export animation
        const exportBtn = document.querySelector('[onclick="exportOrders()"]');
        if (exportBtn) {
            exportBtn.style.transform = 'scale(0.95)';
            setTimeout(() => {
                exportBtn.style.transform = 'scale(1)';
                alert('Export functionality would be implemented here');
            }, 150);
        }
    }

    function exportFiltered() {
        alert('Export filtered results functionality would be implemented here');
    }

    // Add spin animation for refresh button
    const style = document.createElement('style');
    style.textContent = `
    @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    `;
    document.head.appendChild(style);
</script>
