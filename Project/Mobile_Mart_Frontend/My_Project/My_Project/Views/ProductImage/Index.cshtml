@model List<Mobile_Mart.Models.ProductImage>

@{
    ViewData["Title"] = "Product Images";
}

<div class="container mt-4">
    <h2 class="mb-3">Product Images</h2>

    <a asp-asp-controller="ProductImage" asp-action="AddEdit" class="btn btn-success mb-3">+ Add New Image</a>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">Image ID</th>
                <th scope="col">Product Name</th>
                <th scope="col">User Name</th>
                <th scope="col">Image URL</th>
                <th colspan="2">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var img in Model)
                {
                    <tr>
                        <td>@img.ImageId</td>
                        <td>@img.ProductName</td>
                        <td>@img.FullName</td>
                        <td>
                            @if (!string.IsNullOrEmpty(img.ImageUrl))
                            {
                                <img src="@img.ImageUrl" alt="Product Image" class="img-thumbnail" style="max-height: 100px;">
                            }
                            else
                            {
                                <span class="text-muted">No Image</span>
                            }
                        </td>
                        <td>
                            <a asp-action="AddEdit" asp-route-id="@img.ImageId" class="btn btn-primary">Edit</a>
                        </td>
                        <td>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this image?');">
                                <input type="hidden" name="id" value="@img.ImageId" />
                                <input type="submit" class="btn btn-danger" value="Delete" />
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No images found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
