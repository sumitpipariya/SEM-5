        pointer-events: none;
    }

    .premium-action-btn {
        width: 40px;
        height: 40px;
        border: 2px solid var(--premium-gray-200);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        color: var(--premium-gray-600);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--premium-transition);
        text-decoration: none;
    }

        .premium-action-btn:hover {
            border-color: #667eea;
            color: #667eea;
            background: rgba(102, 126, 234, 0.05);
            transform: translateY(-2px);
        }

    /* Premium Table */
    .premium-table-container {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        overflow: hidden;
    }

    .premium-table-header {
        display: flex;
        justify-content: between;
        align-items: center;
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, var(--premium-gray-50), var(--premium-gray-100));
        border-bottom: 1px solid var(--premium-gray-200);
    }

    .premium-table-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--premium-border-radius);
        background: var(--premium-primary);
