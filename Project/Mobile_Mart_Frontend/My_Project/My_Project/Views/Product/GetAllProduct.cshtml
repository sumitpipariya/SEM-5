    /* Premium Pagination */
    .premium-pagination-wrapper {
        display: flex;
        justify-content: between;
        align-items: center;
        padding: 1.5rem 2rem;
        background: var(--premium-gray-50);
        border-top: 1px solid var(--premium-gray-200);
    }

    .premium-pagination-info {
        color: var(--premium-gray-600);
        font-size: 0.875rem;
    }

    .premium-pagination-list {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 0.25rem;
    }

    .premium-pagination-item {
        margin: 0;
    }

    .premium-pagination-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid var(--premium-gray-300);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        color: var(--premium-gray-600);
        text-decoration: none;
        font-weight: 500;
        transition: var(--premium-transition);
    }

        .premium-pagination-link:hover {
            border-color: #667eea;
            color: #667eea;
            background: rgba(102, 126, 234, 0.05);
        }

    .premium-pagination-item.active .premium-pagination-link {
        background: var(--premium-primary);
        border-color: transparent;
        color: var(--premium-light);
    }

    .premium-pagination-item.disabled .premium-pagination-link {
        opacity: 0.5;
        cursor: not-allowed;
    }

        .premium-pagination-item.disabled .premium-pagination-link:hover {
            border-color: var(--premium-gray-300);
            color: var(--premium-gray-600);
            background: var(--premium-light);
        }

    /* Premium Modal */
    .premium-modal {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow-xl);
        border: none;
        overflow: hidden;
        max-width: 500px;
        margin: 0 auto;
    }

    .premium-modal-header {
        display: flex;
        align-items: center;
        padding: 2rem 2rem 1rem;
        border-bottom: 1px solid var(--premium-gray-200);
    }

    .premium-modal-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(250, 112, 154, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fa709a;
        font-size: 1.5rem;
        margin-right: 1rem;
        position: relative;
        overflow: hidden;
    }

    .premium-modal-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(250, 112, 154, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-modal-title {
        font-weight: 700;
        color: var(--premium-gray-900);
        margin: 0;
        flex: 1;
    }

    .premium-modal-close {
        width: 35px;
        height: 35px;
        border: none;
        border-radius: 50%;
        background: var(--premium-gray-100);
        color: var(--premium-gray-600);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--premium-transition);
    }

        .premium-modal-close:hover {
            background: var(--premium-gray-200);
        }

    .premium-modal-body {
        padding: 2rem;
        text-align: center;
    }

    .premium-modal-warning {
        max-width: 350px;
        margin: 0 auto;
    }

    .premium-warning-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: rgba(250, 112, 154, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fa709a;
        font-size: 2.5rem;
        margin: 0 auto 1.5rem;
    }

    .premium-warning-title {
        font-weight: 700;
        color: var(--premium-gray-900);
        margin-bottom: 1rem;
    }

    .premium-warning-message {
        color: var(--premium-gray-600);
        line-height: 1.6;
        margin-bottom: 0;
    }

    .premium-modal-footer {
        display: flex;
        justify-content: center;
        gap: 1rem;
        padding: 1rem 2rem 2rem;
    }

    /* Animations */
    @@keyframes premium-glow {
        0% {
            opacity: 0.3;
            transform: scale(1);
        }

        100% {
            opacity: 0.6;
            transform: scale(1.1);
        }
    }

    @@keyframes premium-float {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-20px);
        }
    }

    @@keyframes premium-chart-grow {
        0% {
            height: 0;
        }

        100% {
            height: var(--height);
        }
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .premium-header-content {
            padding: 2rem 1rem;
        }

        .premium-title {
            font-size: 2rem;
        }

        .premium-subtitle {
            font-size: 1rem;
        }

        .premium-stat-item {
            margin-bottom: 1rem;
        }

        .premium-stats-card {
            margin-bottom: 1rem;
        }

        .premium-search-content {
            padding: 1rem;
        }

        .premium-table-header {
            flex-direction: column;
            gap: 1rem;
            align-items: stretch;
        }

        .premium-table-controls {
            justify-content: center;
        }

        .premium-pagination-wrapper {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }

        .premium-action-buttons {
            flex-direction: column;
            gap: 0.5rem;
        }

        .premium-btn-primary {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .premium-product-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .premium-action-group {
            flex-wrap: wrap;
        }

        .premium-modal {
            margin: 1rem;
        }

        .premium-modal-body {
            padding: 1rem;
        }
    }

    /* Dark mode support */
    @@media (prefers-color-scheme: dark) {
        : root {
            --premium-light: #1a1a2e;
            --premium-dark: #ffffff;
            --premium-gray-50: #2d2d44;
            --premium-gray-100: #3a3a5c;
            --premium-gray-200: #4a4a74;
            --premium-gray-300: #5a5a8c;
            --premium-gray-400: #6a6aa4;
            --premium-gray-500: #7a7abc;
            --premium-gray-600: #8a8ad4;
            --premium-gray-700: #9a9aec;
            --premium-gray-800: #aaaaff;
            --premium-gray-900: #ffffff;
        }
    }

    /* Print styles */
    @@media print {
        .premium-header-particles, .premium-action-buttons, .premium-table-controls, .premium-pagination-wrapper, .premium-action-group {
            display: none !important;
        }

        .premium-table-container {
            box-shadow: none;
            border: 1px solid #000;
        }

        .premium-tr:hover {
            background: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Animate counter numbers
        function animateCounters() {
            const counters = document.querySelectorAll('[data-count]');
            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-count'));
                const duration = 2000;
                const step = target / (duration / 16);
                let current = 0;

                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        counter.textContent = target;
                        clearInterval(timer);
                    } else {
                        counter.textContent = Math.floor(current);
                    }
                }, 16);
            });
        }

        // Start counter animation after a short delay
        setTimeout(animateCounters, 500);

        // Search and filter functionality
        const searchInput = document.getElementById('searchInput');
        const categoryFilter = document.getElementById('categoryFilter');
        const brandFilter = document.getElementById('brandFilter');
        const tableBody = document.getElementById('productTableBody');
        const totalCount = document.getElementById('totalCount');

            function filterTable() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const selectedCategory = categoryFilter ? categoryFilter.value.toLowerCase().trim() : '';
        const selectedBrand = brandFilter ? brandFilter.value.toLowerCase().trim() : '';

        const rows = tableBody.querySelectorAll('.premium-tr');
        let visibleCount = 0;

        rows.forEach(row => {
            const productId = row.dataset.productId?.toLowerCase().trim() || '';
            const productName = row.dataset.productName?.toLowerCase().trim() || '';
            const brand = row.dataset.brand?.toLowerCase().trim() || '';
            const category = row.dataset.category?.toLowerCase().trim() || '';

            const matchesSearch =
                productId.includes(searchTerm) ||
                productName.includes(searchTerm) ||
                brand.includes(searchTerm) ||
                category.includes(searchTerm);

            const matchesCategory = !selectedCategory || category === selectedCategory;
            const matchesBrand = !selectedBrand || brand === selectedBrand;

            if (matchesSearch && matchesCategory && matchesBrand) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // optional: update total count
        const totalCount = document.getElementById('totalCount');
        if (totalCount) {
            totalCount.textContent = `${visibleCount} items`;
        }
    }


        searchInput.addEventListener('input', filterTable);
        categoryFilter.addEventListener('change', filterTable);
        brandFilter.addEventListener('change', filterTable);

        // Enhanced sorting functionality
        document.querySelectorAll('.sortable').forEach(header => {
            header.addEventListener('click', function() {
                const column = this.dataset.column;
                const rows = Array.from(tableBody.querySelectorAll('.premium-tr'));
                const isAscending = !this.classList.contains('sorted-asc');

                // Remove sort classes from all headers
                document.querySelectorAll('.sortable').forEach(h => {
                    h.classList.remove('sorted-asc', 'sorted-desc');
                });

                // Add sort class to current header
                this.classList.add(isAscending ? 'sorted-asc' : 'sorted-desc');

                rows.sort((a, b) => {
                    let aVal = '';
                    let bVal = '';

                    switch(column) {
                        case 'productid':
                            aVal = a.dataset.productId || '';
                            bVal = b.dataset.productId || '';
                            break;
                        case 'productname':
                            aVal = a.dataset.productName || '';
                            bVal = b.dataset.productName || '';
                            break;
                        case 'brand':
                            aVal = a.dataset.brand || '';
                            bVal = b.dataset.brand || '';
                            break;
                        case 'category':
                            aVal = a.dataset.category || '';
                            bVal = b.dataset.category || '';
                            break;
                    }

                    if (isAscending) {
                        return aVal.localeCompare(bVal, undefined, {numeric: true});
                    } else {
                        return bVal.localeCompare(aVal, undefined, {numeric: true});
                    }
                });

                rows.forEach(row => tableBody.appendChild(row));
            });
        });

        // Smooth scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all cards for animation
        document.querySelectorAll('.premium-stats-card, .premium-search-panel, .premium-table-container').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });
    });

    
    function confirmDelete(productId, productName) {
        // Set product name
        document.getElementById('deleteProductName').textContent = productName;

        // Set confirm delete link
        document.getElementById('confirmDeleteBtn').href = `/Product/Delete/${productId}`;

        // Show modal
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModal.show();
    }


    function refreshTable() {
        // Add loading animation
        const refreshBtn = document.querySelector('.premium-refresh-btn');
        const originalContent = refreshBtn.innerHTML;
        refreshBtn.innerHTML = '<i class="bi bi-arrow-clockwise" style="animation: spin 1s linear infinite;"></i> <span>Refreshing...</span>';

        setTimeout(() => {
            location.reload();
        }, 1000);
    }

    function clearFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('categoryFilter').value = '';
        document.getElementById('brandFilter').value = '';
        document.getElementById('searchInput').dispatchEvent(new Event('input'));

        // Add visual feedback
        const inputs = [searchInput, categoryFilter, brandFilter];
        inputs.forEach(input => {
            input.style.transform = 'scale(1.05)';
            setTimeout(() => {
                input.style.transform = 'scale(1)';
            }, 200);
        });
    }

    function exportData() {
        // Show export animation
        const exportBtn = document.querySelector('[onclick="exportData()"]');
        exportBtn.style.transform = 'scale(0.95)';
        setTimeout(() => {
            exportBtn.style.transform = 'scale(1)';
            alert('Export functionality would be implemented here');
        }, 150);
    }

    // Add spin animation for refresh button
    const style = document.createElement('style');
    style.textContent = `
    @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    `;
    document.head.appendChild(style);
</script>
