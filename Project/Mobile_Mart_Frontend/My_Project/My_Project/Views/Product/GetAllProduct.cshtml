@model List<My_Project.Models.ProductModel>
@{
    ViewData["Title"] = "Product Management";
}

<div class="container-fluid ">
    <!-- Premium Header Section -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="premium-header-card">
                <div class="premium-header-bg"></div>
                <div class="premium-header-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center mb-4">
                                <div class="ms-4">
                                    <h1 class="premium-title">Product Management</h1>
                                    <p class="premium-subtitle">Advanced inventory control with intelligent insights</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                            <div class="premium-action-buttons">
                                <a asp-controller="Product" asp-action="AddEdit" class="btn premium-btn-primary">
                                    <i class="bi bi-plus-circle me-2"></i>
                                    Add Product
                                </a>    
                            </div>
                        </div>
                    </div>
                </div>
                <div class="premium-header-particles">
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-primary">
                <div class="premium-stats-icon">
                    <i class="bi bi-boxes"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Total Inventory</div>
                    <div class="premium-stats-value">@(Model?.Count ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bi bi-arrow-up"></i>
                        <span>+12% from last month</span>
                    </div>
                </div>
                <div class="premium-stats-chart">
                    <div class="chart-bar" style="height: 60%"></div>
                    <div class="chart-bar" style="height: 80%"></div>
                    <div class="chart-bar" style="height: 45%"></div>
                    <div class="chart-bar" style="height: 90%"></div>
                    <div class="chart-bar" style="height: 75%"></div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-success">
                <div class="premium-stats-icon">
                    <i class="bi bi-check-shield"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Active Products</div>
                    <div class="premium-stats-value">@(Model?.Count ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bi bi-check-circle"></i>
                        <span>All operational</span>
                    </div>
                </div>
                <div class="premium-stats-progress">
                    <div class="progress-ring">
                        <div class="progress-circle" data-percentage="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-warning">
                <div class="premium-stats-icon">
                    <i class="bi bi-grid-3x3-gap"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Categories</div>
                    <div class="premium-stats-value">@(Model?.Select(p => p.CategoryId).Distinct().Count() ?? 0)</div>
                    <div class="premium-stats-change neutral">
                        <i class="bi bi-diagram-3"></i>
                        <span>Well organized</span>
                    </div>
                </div>
                <div class="premium-stats-wave">
                    <svg viewBox="0 0 100 20">
                        <path d="M0,10 Q25,0 50,10 T100,10" stroke="currentColor" fill="none" stroke-width="2" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-info">
                <div class="premium-stats-icon">
                    <i class="bi bi-building"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Brand Partners</div>
                    <div class="premium-stats-value">@(Model?.Select(p => p.BrandId).Distinct().Count() ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bi bi-graph-up"></i>
                        <span>Growing network</span>
                    </div>
                </div>
                <div class="premium-stats-dots">
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="premium-alert alert-danger">
            <div class="premium-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Error!</div>
                <div class="premium-alert-message">@TempData["Error"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="premium-alert alert-success">
            <div class="premium-alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Success!</div>
                <div class="premium-alert-message">@TempData["Success"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }

    <!-- Premium Search Panel -->
    <div class="premium-search-panel mb-4">
        <div class="premium-search-header">
            <div class="d-flex align-items-center">
                <h5 class="premium-search-title">Advanced Search & Filters</h5>
            </div>
        </div>
        <div class="collapse show" id="searchPanel">
            <div class="premium-search-content">
                <div class="row g-4">
                    <div class="col-lg-7 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Search Products</label>
                            <div class="premium-input-wrapper">
                                <i class="bi bi-search premium-input-icon"></i>
                                <input type="text" id="searchInput" class="premium-form-control"
                                       placeholder="Search by products">
                                <div class="premium-input-focus"></div>
                            </div>
                        </div>
                    </div>

                   
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Products Table -->
    <div class="premium-table-container">
        <div class="premium-table-header">
            <div class="d-flex align-items-center">

                <h5 class="premium-table-title">Product Directory</h5>
                <span class="premium-table-badge" id="totalCount">@(Model?.Count ?? 0) items</span>
            </div>
            <div class="premium-table-controls" style="margin-left:auto">
                <button class="premium-refresh-btn" onclick="refreshTable()">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <div class="premium-table-wrapper">
            <table class="premium-table" id="productsTable">
                <thead>
                    <tr>
                        <th class="premium-th sortable" data-column="productid">
                            <div class="premium-th-content">
                                <i class="bi bi-hash"></i>
                                <span>ID</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="productname">
                            <div class="premium-th-content">
                                <i class="bi bi-box"></i>
                                <span>Product</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="brand">
                            <div class="premium-th-content">
                                <i class="bi bi-building"></i>
                                <span>Brand</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="category">
                            <div class="premium-th-content">
                                <i class="bi bi-tags"></i>
                                <span>Category</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th">
                            <div class="premium-th-content">
                                <i class="bi bi-person"></i>
                                <span>Owner</span>
                            </div>
                        </th>
                        <th class="premium-th text-center">
                            <div class="premium-th-content justify-content-center">
                                <i class="bi bi-gear"></i>
                                <span>Actions</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr class="premium-tr" data-product-id="@product.ProductId"
                                data-category="@(product.Category?.CategoryName ?? "")"
                                data-brand="@(product.Brand?.BrandName ?? "")"
                                data-product-name="@(product.ProductName ?? "")">
                                <td class="premium-td">
                                    <span class="premium-id-badge">#@product.ProductId</span>
                                </td>
                                <td class="premium-td">
                                    <div class="premium-product-info">

                                        <div class="premium-product-details">
                                            <a asp-controller="Product" asp-action="GetAllProduct" asp-route-id="@product.ProductId"
                                               class="premium-product-name">
                                                @product.ProductName
                                            </a>

                                        </div>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    <span class="premium-badge badge-info">
                                        <i class="bi bi-building"></i>
                                        @(product.BrandName)
                                    </span>
                                </td>
                                <td class="premium-td">
                                    <span class="premium-badge badge-warning">
                                        <i class="bi bi-tags"></i>
                                        @(product.CategoryName)
                                    </span>
                                </td>
                                <td class="premium-td">
                                    <div class="premium-owner-info">
                                        <div class="premium-owner-avatar">
                                            <i class="bi bi-person"></i>
                                        </div>
                                        <div class="premium-owner-details">
                                            <div class="premium-owner-name">@(product.FullName)</div>

                                        </div>
                                    </div>
                                </td>
                                <td class="premium-td text-center">
                                    <div class="premium-action-group">
                                        <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@product.ProductId"
                                           class="premium-action-btn action-view" data-bs-toggle="tooltip" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Product" asp-action="AddEdit" asp-route-id="@product.ProductId"
                                           class="premium-action-btn action-edit" data-bs-toggle="tooltip" title="Edit Product">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="premium-action-btn action-delete"
                                                onclick="confirmDelete('@product.ProductId', '@product.ProductName')"
                                                data-bs-toggle="tooltip" title="Delete Product">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noProductsRow">
                            <td colspan="6" class="premium-empty-state">
                                <div class="premium-empty-content">
                                    <div class="premium-empty-icon">
                                        <i class="bi bi-box"></i>
                                        <div class="premium-empty-glow"></div>
                                    </div>
                                    <h5 class="premium-empty-title">No products found</h5>
                                    <p class="premium-empty-message">Get started by adding your first product to the inventory.</p>
                                    <a asp-controller="Product" asp-action="AddEdit" class="premium-btn-primary">
                                        <i class="bi bi-plus-circle me-2"></i>Add Your First Product
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        
    </div>
</div>

<!-- Premium Delete Modal -->
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title">
                    <i class="bx bx-trash text-danger me-2 fs-4"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center px-4">
                <i class="bx bx-error-circle text-danger display-1"></i>
                <h6 class="mt-3 fw-bold">Are you absolutely sure?</h6>
                <p class="text-muted">
                    This action cannot be undone. This will permanently delete the product
                    <strong id="deleteProductName"></strong> and remove all associated data.
                </p>
            </div>

            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" class="btn btn-danger px-4">
                    <i class="bx bx-trash me-1"></i>Delete Product
                </a>
            </div>
        </div>
    </div>
</div>


<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-100: #f8f9fa;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-icon-wrapper {
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-title {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        
    }

    .premium-subtitle {
        font-size: 1.25rem;
        opacity: 0.9;
        font-weight: 300;
        margin-bottom: 0;
    }

    .premium-stat-item {
        text-align: center;
        padding: 1rem;
        background: rgba(255, 255, 255, 0.1);
        border-radius: var(--premium-border-radius);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: var(--premium-transition);
    }

        .premium-stat-item:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.15);
        }

    .premium-stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: var(--premium-light);
    }

    .premium-stat-label {
        font-size: 0.875rem;
        opacity: 0.8;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .premium-stat-trend {
        font-size: 0.75rem;
        opacity: 0.7;
        font-weight: 500;
    }

    .premium-header-particles {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: premium-float 6s ease-in-out infinite;
    }

        .particle:nth-child(1) {
            top: 20%;
            left: 20%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            top: 60%;
            left: 80%;
            animation-delay: 1s;
        }

        .particle:nth-child(3) {
            top: 80%;
            left: 40%;
            animation-delay: 2s;
        }

        .particle:nth-child(4) {
            top: 40%;
            left: 70%;
            animation-delay: 3s;
        }

        .particle:nth-child(5) {
            top: 30%;
            left: 10%;
            animation-delay: 4s;
        }

    /* Premium Buttons */
    .premium-btn-primary {
        background: var(--premium-light);
        color: #667eea;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: var(--premium-transition);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: #5a67d8;
        }

    .premium-btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: var(--premium-light);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 0.75rem 1rem;
        border-radius: var(--premium-border-radius);
        transition: var(--premium-transition);
        backdrop-filter: blur(10px);
    }

        .premium-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

    .premium-btn-danger {
        background: var(--premium-danger);
        color: var(--premium-light);
        border: none;
        padding: 0.75rem 2rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: var(--premium-transition);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: var(--premium-light);
        }

    /* Premium Stats Cards */
    .premium-stats-card {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        padding: 2rem;
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        transition: var(--premium-transition);
        position: relative;
        overflow: hidden;
    }

        .premium-stats-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--premium-shadow-xl);
        }

        .premium-stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--premium-primary);
        }

    .stats-primary::before {
        background: var(--premium-primary);
    }

    .stats-success::before {
        background: var(--premium-success);
    }

    .stats-warning::before {
        background: var(--premium-warning);
    }

    .stats-info::before {
        background: var(--premium-info);
    }

    .premium-stats-icon {
        width: 60px;
        height: 60px;
        border-radius: var(--premium-border-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        position: relative;
    }

    .stats-primary .premium-stats-icon {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(118, 75, 162, 0.1));
        color: #667eea;
    }

    .stats-success .premium-stats-icon {
        background: linear-gradient(135deg, rgba(79, 172, 254, 0.1), rgba(0, 242, 254, 0.1));
        color: #4facfe;
    }

    .stats-warning .premium-stats-icon {
        background: linear-gradient(135deg, rgba(67, 233, 123, 0.1), rgba(56, 249, 215, 0.1));
        color: #43e97b;
    }

    .stats-info .premium-stats-icon {
        background: linear-gradient(135deg, rgba(168, 237, 234, 0.1), rgba(254, 214, 227, 0.1));
        color: #a8edea;
    }

    .premium-stats-label {
        font-size: 0.875rem;
        color: var(--premium-gray-600);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .premium-stats-value {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--premium-gray-900);
        margin-bottom: 1rem;
    }

    .premium-stats-change {
        display: flex;
        align-items: center;
        font-size: 0.875rem;
        font-weight: 500;
    }

        .premium-stats-change.positive {
            color: #10b981;
        }

        .premium-stats-change.neutral {
            color: var(--premium-gray-600);
        }

    .premium-stats-chart {
        position: absolute;
        bottom: 0;
        right: 1rem;
        display: flex;
        align-items: end;
        gap: 2px;
        height: 40px;
    }

    .chart-bar {
        width: 4px;
        background: var(--premium-primary);
        border-radius: 2px 2px 0 0;
        opacity: 0.3;
        animation: premium-chart-grow 2s ease-out;
    }

    .premium-stats-progress {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 50px;
        height: 50px;
    }

    .progress-ring {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .progress-circle {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: conic-gradient(#10b981 0deg, #10b981 360deg, var(--premium-gray-200) 360deg);
        position: relative;
    }

    .premium-stats-wave {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 100px;
        height: 30px;
        opacity: 0.3;
        color: #43e97b;
    }

    .premium-stats-dots {
        position: absolute;
        top: 1rem;
        right: 1rem;
        display: flex;
        gap: 4px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--premium-gray-300);
        transition: var(--premium-transition);
    }

        .dot.active {
            background: #a8edea;
            box-shadow: 0 0 10px rgba(168, 237, 234, 0.5);
        }

    /* Premium Alerts */
    .premium-alert {
        display: flex;
        align-items: center;
        padding: 1rem 1.5rem;
        border-radius: var(--premium-border-radius);
        margin-bottom: 1rem;
        border: none;
        box-shadow: var(--premium-shadow);
        position: relative;
        overflow: hidden;
    }

        .premium-alert::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
        }

    .alert-danger {
        background: linear-gradient(135deg, rgba(250, 112, 154, 0.1), rgba(254, 225, 64, 0.1));
        color: #dc3545;
    }

        .alert-danger::before {
            background: var(--premium-danger);
        }

    .alert-success {
        background: linear-gradient(135deg, rgba(79, 172, 254, 0.1), rgba(0, 242, 254, 0.1));
        color: #198754;
    }

        .alert-success::before {
            background: var(--premium-success);
        }

    .premium-alert-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        font-size: 1.25rem;
    }

    .alert-danger .premium-alert-icon {
        background: rgba(220, 53, 69, 0.1);
    }

    .alert-success .premium-alert-icon {
        background: rgba(25, 135, 84, 0.1);
    }

    .premium-alert-title {
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .premium-alert-message {
        margin-bottom: 0;
        opacity: 0.8;
    }

    .premium-alert-close {
        background: none;
        border: none;
        font-size: 1.25rem;
        margin-left: auto;
        padding: 0.25rem;
        border-radius: 50%;
        transition: var(--premium-transition);
    }

        .premium-alert-close:hover {
            background: rgba(0, 0, 0, 0.1);
        }

    /* Premium Search Panel */
    .premium-search-panel {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        overflow: hidden;
    }

    .premium-search-header {
        display: flex;
        justify-content: between;
        align-items: center;
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, var(--premium-gray-50), var(--premium-gray-100));
        border-bottom: 1px solid var(--premium-gray-200);
    }

    .premium-search-icon {
        width: 40px;
        height: 40px;
        border-radius: var(--premium-border-radius);
        background: var(--premium-primary);
