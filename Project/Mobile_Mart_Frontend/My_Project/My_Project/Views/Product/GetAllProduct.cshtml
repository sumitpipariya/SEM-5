    }

    .premium-input-wrapper {
        position: relative;
    }

    .premium-form-control {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 2px solid var(--premium-gray-200);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        font-size: 0.875rem;
        transition: var(--premium-transition);
        outline: none;
    }

        .premium-form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .premium-input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--premium-gray-500);
        font-size: 1rem;
        z-index: 2;
    }

    .premium-input-focus {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--premium-primary);
        transform: scaleX(0);
        transition: var(--premium-transition);
    }

    .premium-form-control:focus + .premium-input-focus {
        transform: scaleX(1);
    }

    .premium-select-wrapper {
        position: relative;
    }

    .premium-form-select {
        width: 100%;
        padding: 0.75rem 3rem 0.75rem 1rem;
        border: 2px solid var(--premium-gray-200);
        border-radius: var(--premium-border-radius);
        background: var(--premium-light);
        font-size: 0.875rem;
        transition: var(--premium-transition);
        outline: none;
        appearance: none;
    }

        .premium-form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .premium-select-icon {
        position: absolute;
        right: 1rem;
        top: 50%;
