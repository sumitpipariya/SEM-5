        .premium-view-toggle input[type="radio"]:checked + label {
            background: var(--premium-primary);
            color: var(--premium-light);
        }

    .premium-refresh-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #667eea;
        color: var(--premium-light);
        border: none;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        transition: var(--premium-transition);
    }

        .premium-refresh-btn:hover {
            background: #5a67d8;
            transform: translateY(-2px);
        }

    .premium-table-wrapper {
        overflow-x: auto;
    }

    .premium-table {
        width: 100%;
        border-collapse: collapse;
    }

    .premium-th {
        background: var(--premium-gray-50);
        border-bottom: 2px solid var(--premium-gray-200);
        padding: 1rem;
        text-align: left;
        font-weight: 700;
        color: var(--premium-gray-700);
        position: relative;
        user-select: none;
    }

        .premium-th.sortable {
            cursor: pointer;
            transition: var(--premium-transition);
        }

            .premium-th.sortable:hover {
                background: var(--premium-gray-100);
            }

    .premium-th-content {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sort-icon {
        margin-left: auto;
        opacity: 0.5;
        transition: var(--premium-transition);
    }

    .premium-th.sortable.sorted-asc .sort-icon::before {
        content: "\F282";
        opacity: 1;
        color: #667eea;
    }

    .premium-th.sortable.sorted-desc .sort-icon::before {
        content: "\F283";
        opacity: 1;
        color: #667eea;
    }

    .premium-tr {
        border-bottom: 1px solid var(--premium-gray-200);
