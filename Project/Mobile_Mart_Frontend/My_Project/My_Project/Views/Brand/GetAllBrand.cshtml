<script>
    let currentView = 'table';
    let currentSort = { field: 'name', direction: 'asc' };

    // Search functionality
    document.getElementById('searchInput').addEventListener('input', function() {
        filterBrands();
    });

    // Filter functionality
    document.getElementById('userFilter').addEventListener('change', function() {
        filterBrands();
    });

    // Sort functionality
    document.getElementById('sortBy').addEventListener('change', function() {
        sortBrands(this.value);
    });

    function filterBrands() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const userFilter = document.getElementById('userFilter').value;
        const rows = document.querySelectorAll('.premium-table-row');
        const gridItems = document.querySelectorAll('.brand-grid-item'); // Changed selector

        // Filter table rows
        rows.forEach(row => {
            const brandName = row.dataset.brandName || ''; // Changed dataset key
            const userId = row.dataset.userId || '';
            const matchesSearch = brandName.includes(searchTerm);
            const matchesUser = !userFilter || userId === userFilter;

            if (matchesSearch && matchesUser) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });

        // Filter grid items
        gridItems.forEach(item => {
            const brandName = item.dataset.brandName || ''; // Changed dataset key
            const userId = item.dataset.userId || '';
            const matchesSearch = brandName.includes(searchTerm);
            const matchesUser = !userFilter || userId === userFilter;

            if (matchesSearch && matchesUser) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function sortBrands(field) {
        const tbody = document.querySelector('.premium-table-body-content');
        const rows = Array.from(tbody.querySelectorAll('.premium-table-row'));

        rows.sort((a, b) => {
            let aValue, bValue;
            switch(field) {
                case 'id':
                    aValue = parseInt(a.dataset.brandId); // Changed dataset key
                    bValue = parseInt(b.dataset.brandId); // Changed dataset key
                    break;
                case 'name':
                    aValue = a.dataset.brandName || ''; // Changed dataset key
                    bValue = b.dataset.brandName || ''; // Changed dataset key
                    break;
                case 'user':
                    aValue = parseInt(a.dataset.userId);
                    bValue = parseInt(b.dataset.userId);
                    break;
                default:
                    return 0;
            }

            if (aValue < bValue) return currentSort.direction === 'asc' ? -1 : 1;
            if (aValue > bValue) return currentSort.direction === 'asc' ? 1 : -1;
            return 0;
        });

        rows.forEach(row => tbody.appendChild(row));
    }

    function clearFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('userFilter').value = '';
        document.getElementById('sortBy').value = 'name';
        filterBrands();
        sortBrands('name');
    }

    function toggleView() {
        const tableView = document.querySelector('.premium-table-card');
        const gridView = document.getElementById('gridView');
        const toggleBtn = document.querySelector('[onclick="toggleView()"]');

        if (currentView === 'table') {
            tableView.style.display = 'none';
            gridView.style.display = 'flex';
            toggleBtn.innerHTML = '<i class="bi bi-table me-1"></i>Table View';
            currentView = 'grid';
        } else {
            tableView.style.display = 'block';
            gridView.style.display = 'none';
            toggleBtn.innerHTML = '<i class="bi bi-grid-3x3-gap me-1"></i>Grid View';
            currentView = 'table';
        }
    }

    function confirmDelete(brandId, brandName) { // Changed parameter names
        document.getElementById('deleteBrandName').textContent = brandName; // Changed ID
        document.getElementById('confirmDeleteBtn').href = `/Brand/Delete/${brandId}`; // Changed controller and parameter
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModal.show();
    }

    function exportBrands() { // Changed function name
        const btn = event.target;
        const originalContent = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise" style="animation: spin 1s linear infinite;"></i> Exporting...';
        setTimeout(() => {
            btn.innerHTML = originalContent;
            alert('Export functionality would be implemented here');
        }, 2000);
    }

    // Initialize tooltips and animations
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.premium-stat-card, .premium-filter-card, .premium-table-card, .premium-brand-card').forEach(el => { // Changed selector
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(el);
        });

        document.querySelectorAll('.premium-th.sortable').forEach(th => {
            th.addEventListener('click', function() {
                const sortField = this.dataset.sort;
                const sortIcon = this.querySelector('.premium-sort-icon');

                document.querySelectorAll('.premium-sort-icon').forEach(icon => {
                    if (icon !== sortIcon) {
                        icon.className = 'bi bi-chevron-expand premium-sort-icon';
                    }
                });

                if (currentSort.field === sortField) {
                    currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSort.field = sortField;
                    currentSort.direction = 'asc';
                }

                sortIcon.className = currentSort.direction === 'asc'
                    ? 'bi bi-chevron-up premium-sort-icon'
                    : 'bi bi-chevron-down premium-sort-icon';

                sortBrands(sortField); // Changed function call
            });
        });
    });

    const style = document.createElement('style');
    style.textContent = `
    @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    `;
    document.head.appendChild(style);

    
    setTimeout(() => {
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(alert => {
            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
            bsAlert.close();
        });
    }, 5000); 



</script>
