@model List<My_Project.Models.BrandModel>

@{
    ViewData["Title"] = "Brand Management";
}

<div class="container-fluid">
 
    <!-- Premium Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="premium-header-card">
                <div class="premium-header-bg"></div>
                <div class="premium-header-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center">
                                <div class="premium-brand-icon">
                                    <i class="bi bi-tags"></i> @* Changed icon to bi-tags for brands *@
                                    <div class="premium-icon-glow"></div>
                                </div>
                                <div class="ms-4">
                                    <h1 class="premium-brand-title">Brand Management</h1>
                                    <p class="premium-brand-subtitle">
                                        <i class="bi bi-bookmark me-1"></i>Manage and organize your product brands
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                            <div class="premium-action-buttons">
                                <a asp-controller="Brand" asp-action="AddEdit" class="premium-btn premium-btn-primary">
                                    <i class="bi bi-plus-circle me-2"></i>Add Brand
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="premium-header-particles">
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Statistics Cards -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="premium-stat-card stat-primary">
                <div class="premium-stat-icon">
                    <i class="bi bi-bookmark"></i> @* Changed icon *@
                </div>
                <div class="premium-stat-content">
                    <div class="premium-stat-number">@(Model?.Count ?? 0)</div>
                    <div class="premium-stat-label">Total Brands</div>
                </div>
                <div class="premium-stat-glow"></div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="premium-stat-card stat-success">
                <div class="premium-stat-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="premium-stat-content">
                    <div class="premium-stat-number">@(Model?.Count ?? 0)</div>
                    <div class="premium-stat-label">Active Brands</div>
                </div>
                <div class="premium-stat-glow"></div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="premium-stat-card stat-warning">
                <div class="premium-stat-icon">
                    <i class="bi bi-person-check"></i>
                </div>
                <div class="premium-stat-content">
                    <div class="premium-stat-number">@(Model?.Select(b => b.UserId).Distinct().Count() ?? 0)</div>
                    <div class="premium-stat-label">Contributors</div>
                </div>
                <div class="premium-stat-glow"></div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="premium-stat-card stat-info">
                <div class="premium-stat-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div class="premium-stat-content">
                    <div class="premium-stat-number">@(Model?.Any() == true ? (DateTime.Now - Model.Min(b => b.Created ?? DateTime.Now)).Days : 0)</div>
                    <div class="premium-stat-label">Days Active</div>
                </div>
                <div class="premium-stat-glow"></div>
            </div>
        </div>
    </div>

    @* <!-- Premium Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="premium-filter-card">
                <div class="premium-filter-header">
                    <h6 class="premium-filter-title">
                        <i class="bi bi-funnel me-2"></i>Search & Filter
                    </h6>
                </div>
                <div class="premium-filter-body">
                    <div class="row g-3">
                        <div class="col-lg-4 col-md-6">
                            <div class="premium-search-box">
                                <i class="bi bi-search premium-search-icon"></i>
                                <input type="text" id="searchInput" class="premium-search-input" placeholder="Search brands...">
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <select id="userFilter" class="premium-select">
                                <option value="">All Users</option>
                                @if (Model != null)
                                {
                                    foreach (var userId in Model.Select(b => b.FullName).Distinct())
                                    {
                                        <option value="@userId"> @userId</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <select id="sortBy" class="premium-select">
                                <option value="name">Sort by Name</option>
                                <option value="id">Sort by ID</option>
                                <option value="user">Sort by User</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <button type="button" class="premium-btn premium-btn-outline w-100" onclick="clearFilters()">
                                <i class="bi bi-arrow-clockwise me-2"></i>Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> *@


    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="premium-alert alert-danger">
            <div class="premium-alert-icon">
                <i class="bx bx-error-circle"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Error!</div>
                <div class="premium-alert-message">@TempData["Error"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bx bx-x"></i>
            </button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="premium-alert alert-success">
            <div class="premium-alert-icon">
                <i class="bx bx-check-circle"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Success!</div>
                <div class="premium-alert-message">@TempData["Success"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bx bx-x"></i>
            </button>
        </div>
    }
    <!-- Premium Brands Table -->
    <div class="row">
        <div class="col-12">
            <div class="premium-table-card">
                <div class="premium-table-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="premium-table-title">
                            <i class="bi bi-table me-2"></i>Brands List
                        </h6>
                        <div class="premium-table-actions">
                            <button type="button" class="premium-btn premium-btn-sm premium-btn-outline" onclick="toggleView()">
                                <i class="bi bi-grid-3x3-gap me-1"></i>Grid View
                            </button>
                        </div>
                    </div>
                </div>
                <div class="premium-table-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="premium-table-responsive">
                            <table class="premium-table" id="brandsTable">
                                <thead class="premium-table-head">
                                    <tr>
                                        <th class="premium-th sortable" data-sort="id">
                                            <div class="premium-th-content">
                                                <i class="bi bi-hash me-2"></i>Brand ID
                                                <i class="bi bi-chevron-expand premium-sort-icon"></i>
                                            </div>
                                        </th>
                                        <th class="premium-th sortable" data-sort="name">
                                            <div class="premium-th-content">
                                                <i class="bi bi-tag me-2"></i>Brand Name
                                                <i class="bi bi-chevron-expand premium-sort-icon"></i>
                                            </div>
                                        </th>
                                        <th class="premium-th sortable" data-sort="user">
                                            <div class="premium-th-content">
                                                <i class="bi bi-person me-2"></i>User Name
                                                <i class="bi bi-chevron-expand premium-sort-icon"></i>
                                            </div>
                                        </th>
                                        <th class="premium-th text-center">
                                            <div class="premium-th-content justify-content-center">
                                                <i class="bx bx-cog"></i>
                                                <span>Actions</span>
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="premium-table-body-content">
                                    @foreach (var brand in Model)
                                    {
                                        <tr class="premium-table-row" data-brand-id="@brand.BrandId" data-brand-name="@brand.BrandName?.ToLower()" data-user-id="@brand.UserId">
                                            <td class="premium-td">
                                                <div class="premium-cell-content">
                                                    <div class="premium-id-badge">
                                                        <i class="bi bi-hash"></i>
                                                        @brand.BrandId
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="premium-td">
                                                <div class="premium-cell-content">
                                                    <div class="premium-brand-info">
                                                        <div class="premium-brand-avatar">
                                                            <i class="bi bi-bookmark"></i> @* Changed icon *@
                                                        </div>
                                                        <div class="premium-brand-details">
                                                            <div class="premium-brand-name">@brand.BrandName</div>
                                                            <div class="premium-brand-meta">
                                                                @if (brand.Created.HasValue)
                                                                {
                                                                    <span class="premium-meta-item">
                                                                        <i class="bi bi-calendar3 me-1"></i>
                                                                        @brand.Created.Value.ToString("MMM dd, yyyy")
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="premium-td">
                                                <div class="premium-cell-content">
                                                    <div class="premium-user-badge">
                                                        <i class="bi bi-person-circle me-2"></i>
                                                        User #@brand.FullName
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="premium-td">
                                                <div class="premium-cell-content">
                                                    <div class="premium-action-group">
                                                        <a asp-controller="Brand" asp-action="BrandDetails" asp-route-id="@brand.BrandId"
                                                           class="premium-action-btn premium-action-view"
                                                           data-bs-toggle="tooltip" title="View Details">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a asp-controller="Brand" asp-action="AddEdit" asp-route-id="@brand.BrandId"
                                                           class="premium-action-btn premium-action-edit"
                                                           data-bs-toggle="tooltip" title="Edit Brand">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </a>
                                                        <button type="button" class="premium-action-btn action-delete"
                                                                onclick="confirmDelete('@brand.BrandId', '@brand.BrandName')"
                                                                data-bs-toggle="tooltip" title="Delete Brand">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="premium-empty-state">
                            <div class="premium-empty-icon">
                                <i class="bi bi-bookmark"></i> @* Changed icon *@
                            </div>
                            <h5 class="premium-empty-title">No Brands Found</h5>
                            <p class="premium-empty-message">Get started by creating your first brand to organize your products.</p>
                            <a asp-controller="Brand" asp-action="AddEdit" class="premium-btn premium-btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>Create First Brand
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Grid View (Hidden by default) -->
    <div class="row" id="gridView" style="display: none;">
        @if (Model != null && Model.Any())
        {
            @foreach (var brand in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4 brand-grid-item" data-brand-id="@brand.BrandId" data-brand-name="@brand.BrandName?.ToLower()" data-user-id="@brand.UserId">
                    <div class="premium-brand-card">
                        <div class="premium-brand-card-header">
                            <div class="premium-brand-card-icon">
                                <i class="bi bi-bookmark"></i> @* Changed icon *@
                            </div>
                            <div class="premium-brand-card-id">#@brand.BrandId</div>
                        </div>
                        <div class="premium-brand-card-body">
                            <h6 class="premium-brand-card-title">@brand.BrandName</h6>
                            <div class="premium-brand-card-meta">
                                <div class="premium-meta-item">
                                    <i class="bi bi-person-circle me-2"></i>
                                    User #@brand.UserId
                                </div>
                                @if (brand.Created.HasValue)
                                {
                                    <div class="premium-meta-item">
                                        <i class="bi bi-calendar3 me-2"></i>
                                        @brand.Created.Value.ToString("MMM dd, yyyy")
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="premium-brand-card-footer">
                            <div class="premium-card-actions">
                                <a asp-controller="Brand" asp-action="BrandDetails" asp-route-id="@brand.BrandId"
                                   class="premium-card-action premium-card-action-view">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="Brand" asp-action="Add   Edit" asp-route-id="@brand.BrandId"
                                   class="premium-card-action premium-card-action-edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button" class="premium-card-action premium-card-action-delete"
                                        onclick="confirmDelete('@brand.BrandId', '@brand.BrandName')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Premium Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title">
                    <i class="bx bx-trash text-danger me-2 fs-4"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center px-4">
                <i class="bx bx-error-circle text-danger display-1"></i>
                <h6 class="mt-3 fw-bold">Are you absolutely sure?</h6>
                <p class="text-muted">
                    This action cannot be undone. This will permanently delete the brand
                    <strong id="deleteBrandName"></strong> and remove all associated data.
                </p>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" class="btn btn-danger px-4">
                    <i class="bx bx-trash me-1"></i>Delete brand
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-50: #f8f9fa;
        --premium-gray-100: #f1f3f4;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Premium Breadcrumb */
    .premium-breadcrumb {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius);
        padding: 1rem 1.5rem;
        margin: 0;
        box-shadow: var(--premium-shadow-sm);
        border: 1px solid var(--premium-gray-200);
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .premium-breadcrumb-item {
        display: flex;
        align-items: center;
    }

    .premium-breadcrumb-link {
        color: var(--premium-gray-600);
        text-decoration: none;
        font-weight: 500;
        transition: var(--premium-transition);
        display: flex;
        align-items: center;
    }

        .premium-breadcrumb-link:hover {
            color: #667eea;
        }

    .premium-breadcrumb-item.active {
        color: var(--premium-gray-800);
        font-weight: 600;
    }

    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        border: 1px solid var(--premium-gray-200);
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-brand-icon { /* Changed from premium-category-icon */
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-brand-title { /* Changed from premium-category-title */
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .premium-brand-subtitle { /* Changed from premium-category-subtitle */
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 0;
    }

    .premium-header-particles {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: rgba(255, 255, 255, 0.6);
        border-radius: 50%;
        animation: premium-float 6s ease-in-out infinite;
    }

        .particle:nth-child(1) {
            top: 20%;
            left: 20%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            top: 60%;
            left: 80%;
            animation-delay: 1s;
        }

        .particle:nth-child(3) {
            top: 80%;
            left: 40%;
            animation-delay: 2s;
        }

        .particle:nth-child(4) {
            top: 40%;
            left: 70%;
            animation-delay: 3s;
        }

        .particle:nth-child(5) {
            top: 30%;
            left: 10%;
            animation-delay: 4s;
        }

    /* Premium Buttons */
    .premium-btn {
        padding: 0.75rem 1.5rem;
        border-radius: var(--premium-border-radius);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: var(--premium-transition);
        border: none;
        cursor: pointer;
    }

    .premium-btn-sm {
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
    }

    .premium-btn-primary {
        background: var(--premium-light);
        color: #667eea;
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: #5a67d8;
        }

    .premium-btn-secondary {
        background: rgba(255, 255, 255, 0.2);
        color: var(--premium-light);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
    }

        .premium-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: var(--premium-light);
        }

    .premium-btn-outline {
        background: transparent;
        color: #667eea;
        border: 2px solid #667eea;
    }

        .premium-btn-outline:hover {
            background: #667eea;
            color: var(--premium-light);
            transform: translateY(-2px);
        }

    .premium-btn-danger {
        background: var(--premium-danger);
        color: var(--premium-light);
        box-shadow: var(--premium-shadow);
    }

        .premium-btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--premium-shadow-lg);
            color: var(--premium-light);
        }

    .premium-action-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* Premium Statistics Cards */
    .premium-stat-card {
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-lg);
        padding: 2rem;
        box-shadow: var(--premium-shadow);
        border: 1px solid var(--premium-gray-200);
        position: relative;
        overflow: hidden;
        transition: var(--premium-transition);
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

        .premium-stat-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--premium-shadow-lg);
        }

    .premium-stat-icon {
        width: 60px;
        height: 60px;
        border-radius: var(--premium-border-radius);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--premium-light);
        flex-shrink: 0;
    }

