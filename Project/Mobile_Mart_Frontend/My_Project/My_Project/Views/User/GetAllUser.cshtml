</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let currentPage = 1;
        let itemsPerPage = 10;
        let filteredRows = [];
        let allRows = [];

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        const tableBody = document.getElementById('userTableBody');
        allRows = Array.from(tableBody.querySelectorAll('.premium-tr'));
        filteredRows = [...allRows];

        console.log("[v0] Total rows found:", allRows.length);
        console.log("[v0] Filtered rows:", filteredRows.length);

        initializePagination();

        // Search functionality
        const searchInput = document.getElementById('searchInput');
        const roleFilter = document.getElementById('roleFilter');
        const cityFilter = document.getElementById('cityFilter');
        const totalCount = document.getElementById('totalCount');

        function filterTable() {
            const searchTerm = searchInput.value.toLowerCase();
            const selectedRole = roleFilter.value;
            const selectedCity = cityFilter.value;

            filteredRows = allRows.filter(row => {
                const fullName = row.dataset.fullname?.toLowerCase() || '';
                const email = row.dataset.email?.toLowerCase() || '';
                const phone = row.dataset.phone?.toLowerCase() || '';
                const role = row.dataset.role || '';
                const city = row.dataset.city || '';

                const matchesSearch = fullName.includes(searchTerm) ||
                                    email.includes(searchTerm) ||
                                    phone.includes(searchTerm);
                const matchesRole = !selectedRole || role === selectedRole;
                const matchesCity = !selectedCity || city === selectedCity;

                return matchesSearch && matchesRole && matchesCity;
            });

            currentPage = 1;
            updatePagination();
            displayCurrentPage();
            totalCount.textContent = `${filteredRows.length} users`;
        }

        function initializePagination() {
            const itemsPerPageSelect = document.getElementById('itemsPerPage');
            itemsPerPageSelect.addEventListener('change', function() {
                itemsPerPage = parseInt(this.value);
                currentPage = 1;
                updatePagination();
                displayCurrentPage();
            });

            updatePagination();
            displayCurrentPage();
        }

        function updatePagination() {
            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            const paginationList = document.getElementById('pagination');

            console.log("[v0] Current page:", currentPage);
            console.log("[v0] Total pages:", totalPages);
            console.log("[v0] Items per page:", itemsPerPage);

            paginationList.innerHTML = '';

            if (totalPages === 0) {
                const noDataItem = document.createElement('li');
                noDataItem.className = 'premium-pagination-item disabled';
                noDataItem.innerHTML = '<span class="premium-pagination-link">No data</span>';
                paginationList.appendChild(noDataItem);
                return;
            }

            // Previous button
            const prevItem = document.createElement('li');
            prevItem.className = `premium-pagination-item ${currentPage === 1 ? 'disabled' : ''}`;
            if (currentPage === 1) {
                prevItem.innerHTML = `
                    <span class="premium-pagination-link">
                        <i class="bi bi-chevron-left"></i>
                    </span>
                `;
            } else {
                prevItem.innerHTML = `
                    <a class="premium-pagination-link" href="#" onclick="changePage(${currentPage - 1}); return false;">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                `;
            }
            paginationList.appendChild(prevItem);

            // Page numbers
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                const firstItem = document.createElement('li');
                firstItem.className = 'premium-pagination-item';
                firstItem.innerHTML = `<a class="premium-pagination-link" href="#" onclick="changePage(1); return false;">1</a>`;
                paginationList.appendChild(firstItem);

                if (startPage > 2) {
                    const dotsItem = document.createElement('li');
                    dotsItem.className = 'premium-pagination-item';
                    dotsItem.innerHTML = `<span class="premium-pagination-link">...</span>`;
                    paginationList.appendChild(dotsItem);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                const pageItem = document.createElement('li');
                pageItem.className = `premium-pagination-item ${i === currentPage ? 'active' : ''}`;

                if (i === currentPage) {
                    pageItem.innerHTML = `<span class="premium-pagination-link">${i}</span>`;
                } else {
                    pageItem.innerHTML = `<a class="premium-pagination-link" href="#" onclick="changePage(${i}); return false;">${i}</a>`;
                }
                paginationList.appendChild(pageItem);
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const dotsItem = document.createElement('li');
                    dotsItem.className = 'premium-pagination-item';
                    dotsItem.innerHTML = `<span class="premium-pagination-link">...</span>`;
                    paginationList.appendChild(dotsItem);
                }

                const lastItem = document.createElement('li');
                lastItem.className = 'premium-pagination-item';
                lastItem.innerHTML = `<a class="premium-pagination-link" href="#" onclick="changePage(${totalPages}); return false;">${totalPages}</a>`;
                paginationList.appendChild(lastItem);
            }

            // Next button
            const nextItem = document.createElement('li');
            nextItem.className = `premium-pagination-item ${currentPage === totalPages ? 'disabled' : ''}`;
            if (currentPage === totalPages || totalPages === 0) {
                nextItem.innerHTML = `
                    <span class="premium-pagination-link">
                        <i class="bi bi-chevron-right"></i>
                    </span>
                `;
            } else {
                nextItem.innerHTML = `
                    <a class="premium-pagination-link" href="#" onclick="changePage(${currentPage + 1}); return false;">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                `;
            }
            paginationList.appendChild(nextItem);

            updatePaginationInfo();
        }

        function displayCurrentPage() {
            console.log("[v0] Displaying page:", currentPage);

            // Hide all rows first
            allRows.forEach(row => {
                row.style.display = 'none';
            });

            // Calculate start and end indices
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;

            console.log("[v0] Start index:", startIndex, "End index:", endIndex);
            console.log("[v0] Filtered rows length:", filteredRows.length);

            // Show rows for current page
            const rowsToShow = filteredRows.slice(startIndex, endIndex);
            console.log("[v0] Rows to show:", rowsToShow.length);

            rowsToShow.forEach((row, index) => {
                row.style.display = '';
                console.log("[v0] Showing row:", index, row.dataset.fullname);
            });

            if (rowsToShow.length === 0 && filteredRows.length > 0) {
                console.log("[v0] No rows to show on current page, going to page 1");
                changePage(1);
            }
        }

        function updatePaginationInfo() {
            const startIndex = (currentPage - 1) * itemsPerPage + 1;
            const endIndex = Math.min(currentPage * itemsPerPage, filteredRows.length);

            document.getElementById('showingStart').textContent = filteredRows.length > 0 ? startIndex : 0;
            document.getElementById('showingEnd').textContent = endIndex;
            document.getElementById('totalEntries').textContent = filteredRows.length;
        }

        window.changePage = function(page) {
            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            console.log("[v0] Changing to page:", page, "Total pages:", totalPages);

            if (page >= 1 && page <= totalPages) {
                currentPage = page;
                updatePagination();
                displayCurrentPage();
            }
            return false; // Prevent default link behavior
        };

        window.goToFirstPage = function() {
            changePage(1);
            return false;
        };

        window.goToLastPage = function() {
            const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
            changePage(totalPages);
            return false;
        };

        // Event listeners for search and filters
        searchInput.addEventListener('input', filterTable);
        roleFilter.addEventListener('change', filterTable);
        cityFilter.addEventListener('change', filterTable);
    });

    function changePage(page) {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            updatePagination();
            displayCurrentPage();
        }
    }

    function goToFirstPage() {
        changePage(1);
    }

    function goToLastPage() {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        changePage(totalPages);
    }

    // Clear filters function
    function clearFilters() {
        document.getElementById('searchInput').value = '';
        document.getElementById('roleFilter').value = '';
        document.getElementById('cityFilter').value = '';

        filteredRows = [...allRows];
        currentPage = 1;
        updatePagination();
        displayCurrentPage();

        // Update count
        document.getElementById('totalCount').textContent = `${filteredRows.length} users`;
    }

    // Refresh table function
    function refreshTable() {
        location.reload();
    }


    // Delete confirmation
    function confirmDelete(userId, userName) {
        document.getElementById('deleteUserName').textContent = userName;
        document.getElementById('confirmDeleteBtn').href = `/User/Delete/${userId}`;

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        deleteModal.show();
    }

</script>

