        color: var(--premium-light);
    }

    .premium-pagination-item.disabled .premium-pagination-link {
        opacity: 0.5;
        cursor: not-allowed;
    }

        .premium-pagination-item.disabled .premium-pagination-link:hover {
            border-color: var(--premium-gray-300);
            color: var(--premium-gray-600);
            background: var(--premium-light);
        }

    /* Animations */
