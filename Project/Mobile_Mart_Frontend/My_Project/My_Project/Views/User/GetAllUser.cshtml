@model List<My_Project.Models.UserModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid">
    <!-- Premium Header Section -->
    <div class="row ">
        <div class="col-12">
            <div class="premium-header-card">
                <div class="premium-header-bg"></div>
                <div class="premium-header-content">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center mb-4">
                                <div class="premium-icon-wrapper">
                                    <i class="bi bi-people"></i>
                                    <div class="premium-icon-glow"></div>
                                </div>
                                <div class="ms-4">
                                    <h1 class="premium-title">User Management</h1>
                                    <p class="premium-subtitle">Comprehensive user administration with advanced analytics and insights</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                            <div class="premium-action-buttons">
                                <a asp-controller="User" asp-action="AddEdit" class="btn premium-btn-primary">
                                    <i class="bi bi-person-plus me-2"></i>
                                    Add New User
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="premium-header-particles">
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                    <div class="particle"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-primary">
                <div class="premium-stats-icon">
                    <i class="bi bi-people"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Total Users</div>
                    <div class="premium-stats-value">@(Model?.Count ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bi bi-arrow-up"></i>
                        <span>+12% from last month</span>
                    </div>
                </div>
                <div class="premium-stats-chart">
                    <div class="chart-bar" style="height: 75%"></div>
                    <div class="chart-bar" style="height: 90%"></div>
                    <div class="chart-bar" style="height: 65%"></div>
                    <div class="chart-bar" style="height: 100%"></div>
                    <div class="chart-bar" style="height: 85%"></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-success">
                <div class="premium-stats-icon">
                    <i class="bi bi-person-check"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Active Users</div>
                    <div class="premium-stats-value">@(Model?.Count(x => x.Role == "User") ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bi bi-check-circle"></i>
                        <span>All systems operational</span>
                    </div>
                </div>
                <div class="premium-stats-progress">
                    <div class="progress-ring">
                        <div class="progress-circle" data-percentage="88"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-warning">
                <div class="premium-stats-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">Admin Users</div>
                    <div class="premium-stats-value">@(Model?.Count(x => x.Role == "Admin") ?? 0)</div>
                    <div class="premium-stats-change neutral">
                        <i class="bi bi-gear"></i>
                        <span>System administrators</span>
                    </div>
                </div>
                <div class="premium-stats-wave">
                    <svg viewBox="0 0 100 20">
                        <path d="M0,10 Q25,0 50,10 T100,10" stroke="currentColor" fill="none" stroke-width="2" />
                    </svg>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="premium-stats-card stats-info">
                <div class="premium-stats-icon">
                    <i class="bi bi-calendar-plus"></i>
                </div>
                <div class="premium-stats-content">
                    <div class="premium-stats-label">New This Month</div>
                    <div class="premium-stats-value">@(Model?.Count(x => x.Created >= DateTime.Now.AddDays(-30)) ?? 0)</div>
                    <div class="premium-stats-change positive">
                        <i class="bi bi-graph-up"></i>
                        <span>Growing community</span>
                    </div>
                </div>
                <div class="premium-stats-dots">
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot active"></div>
                    <div class="dot"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Error"] != null)
    {
        <div class="premium-alert alert-danger">
            <div class="premium-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Error!</div>
                <div class="premium-alert-message">@TempData["Error"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="premium-alert alert-success">
            <div class="premium-alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="premium-alert-content">
                <div class="premium-alert-title">Success!</div>
                <div class="premium-alert-message">@TempData["Success"]</div>
            </div>
            <button type="button" class="premium-alert-close" data-bs-dismiss="alert">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }

    <!-- Premium Search Panel -->
    <div class="premium-search-panel mb-4">
        <div class="premium-search-header">
            <div class="d-flex align-items-center">
                <div class="premium-search-icon">
                    <i class="bi bi-funnel"></i>
                </div>
                <h5 class="premium-search-title">Advanced Search & Filters</h5>
            </div>
            <button class="premium-toggle-btn" data-bs-toggle="collapse" data-bs-target="#searchPanel">
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
        <div class="collapse show" id="searchPanel">
            <div class="premium-search-content">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Search Users</label>
                            <div class="premium-input-wrapper">
                                <i class="bi bi-search premium-input-icon"></i>
                                <input type="text" id="searchInput" class="premium-form-control"
                                       placeholder="Search by name, email, phone...">
                                <div class="premium-input-focus"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="premium-form-group">
                            <label for="roleFilter" class="premium-form-label">Role</label>
                            <div class="premium-select-wrapper position-relative">
                                <select id="roleFilter" class="premium-form-select" onchange="filterTable()" title="Filter by user role">
                                    <option value="">All Roles</option>
                                    <option value="User">User</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <i class="bi bi-chevron-down premium-select-icon position-absolute top-50 end-0 translate-middle-y pe-3"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="premium-form-group">
                            <label for="cityFilter" class="premium-form-label">City</label>
                            <div class="premium-select-wrapper position-relative">
                                <select id="cityFilter" class="premium-form-select" onchange="filterTable()" title="Filter by city">
                                    <option value="">All Cities</option>
                                    @if (Model != null)
                                    {
                                        @foreach (var city in Model.Where(x => !string.IsNullOrEmpty(x.City)).Select(x => x.City).Distinct().OrderBy(x => x))
                                        {
                                            <option value="@city">@city</option>
                                        }
                                    }
                                </select>
                                <i class="bi bi-chevron-down premium-select-icon position-absolute top-50 end-0 translate-middle-y pe-3"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-12">
                        <div class="premium-form-group">
                            <label class="premium-form-label">Actions</label>
                            <div class="d-flex gap-2">
                                <button type="button" class="premium-action-btn" onclick="clearFilters()" data-bs-toggle="tooltip" title="Clear filters">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                              
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Premium Users Table -->
    <div class="premium-table-container">
        <div class="premium-table-header">
            <div class="d-flex align-items-center">
                <div class="premium-table-icon">
                    <i class="bi bi-table"></i>
                </div>
                <div>
                    <h5 class="premium-table-title">Users Directory</h5>
                    <span class="premium-table-badge" id="totalCount">@(Model?.Count ?? 0) users</span>
                </div>
            </div>
            <div class="premium-table-controls" style="margin-left:auto">
              
                <button class="premium-refresh-btn" onclick="refreshTable()">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <div class="premium-table-wrapper">
            <table class="premium-table" id="usersTable">
                <thead>
                    <tr>
                        <th class="premium-th sortable" data-column="fullname">
                            <div class="premium-th-content">
                                <i class="bi bi-person"></i>
                                <span>User</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="email">
                            <div class="premium-th-content">
                                <i class="bi bi-envelope"></i>
                                <span>Email</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="phone">
                            <div class="premium-th-content">
                                <i class="bi bi-telephone"></i>
                                <span>Phone</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="role">
                            <div class="premium-th-content">
                                <i class="bi bi-shield"></i>
                                <span>Role</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                        <th class="premium-th sortable" data-column="location">
                            <div class="premium-th-content">
                                <i class="bi bi-geo-alt"></i>
                                <span>Location</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th>
                       @*  <th class="premium-th sortable" data-column="created">
                            <div class="premium-th-content">
                                <i class="bi bi-calendar"></i>
                                <span>Joined</span>
                                <i class="bi bi-chevron-expand sort-icon"></i>
                            </div>
                        </th> *@
                        <th class="premium-th text-center">
                            <div class="premium-th-content justify-content-center">
                                <i class="bi bi-gear"></i>
                                <span>Actions</span>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody id="userTableBody">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr class="premium-tr"
                                data-user-id="@user.UserID"
                                data-fullname="@user.FullName"
                                data-email="@user.Email"
                                data-phone="@user.Phone"
                                data-role="@user.Role"
                                 data-city="@user.City"
                            @*  data-created="@user.Created.ToString("yyyy-MM-dd")" *@>
                                <td class="premium-td">
                                    <div class="premium-item-info">
                                        <div class="premium-item-avatar">
                                            <i class="bi bi-person"></i>
                                            <div class="premium-avatar-glow"></div>
                                        </div>
                                        <div class="premium-item-details">
                                            <div class="premium-item-id">@user.FullName</div>
                                            <div class="premium-item-label">ID: #@user.UserID</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    <div class="premium-email-info">
                                        <div class="premium-email-main">@user.Email</div>
                                        <div class="premium-email-label">Primary Email</div>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    @if (!string.IsNullOrEmpty(user.Phone))
                                    {
                                        <div class="premium-phone-badge">
                                            <i class="bi bi-telephone"></i>
                                            <span>@user.Phone</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="premium-null-value">No Phone</span>
                                    }
                                </td>
                                <td class="premium-td">
                                    <div class="premium-role-badge role-@user.Role.ToLower()">
                                        @if (user.Role == "Admin")
                                        {
                                            <i class="bi bi-shield-fill"></i>
                                        }
                                        else if (user.Role == "Manager")
                                        {
                                            <i class="bi bi-person-gear"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person"></i>
                                        }
                                        <span>@user.Role</span>
                                    </div>
                                </td>
                                <td class="premium-td">
                                    @if (!string.IsNullOrEmpty(user.City) && !string.IsNullOrEmpty(user.State))
                                    {
                                        <div class="premium-location-info">
                                            <div class="premium-location-main">@user.City, @user.State</div>
                                            @if (!string.IsNullOrEmpty(user.Pincode))
                                            {
                                                <div class="premium-location-label">@user.Pincode</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="premium-null-value">No Location</span>
                                    }
                                </td>
                                @*  <td class="premium-td">
                                    <div class="premium-date-info">
                                        <div class="premium-date-main">@user.Created.ToString("MMM dd, yyyy")</div>
                                        <div class="premium-date-label">@user.Created.ToString("hh:mm tt")</div>
                                    </div>
                                </td> *@
                                <td class="premium-td text-center">
                                    <div class="premium-action-group">
                                        <a asp-controller="User" asp-action="UserDetails" asp-route-id="@user.UserID"
                                           class="premium-action-btn action-view" data-bs-toggle="tooltip" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="User" asp-action="AddEdit" asp-route-id="@user.UserID"
                                           class="premium-action-btn action-edit" data-bs-toggle="tooltip" title="Edit User">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                       @*  <button type="button" class="premium-action-btn action-message"
                                                onclick="sendMessage('@user.UserID', '@user.Email')"
                                                data-bs-toggle="tooltip" title="Send Message">
                                            <i class="bi bi-envelope"></i>
                                        </button> *@
                                        <button type="button" class="premium-action-btn action-delete"
                                                onclick="confirmDelete('@user.UserID', '@user.FullName')"
                                                data-bs-toggle="tooltip" title="Delete User">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="noUsersRow">
                            <td colspan="7" class="premium-empty-state">
                                <div class="premium-empty-content">
                                    <div class="premium-empty-icon">
                                        <i class="bi bi-people"></i>
                                        <div class="premium-empty-glow"></div>
                                    </div>
                                    <h5 class="premium-empty-title">No users found</h5>
                                    <p class="premium-empty-message">Get started by adding your first user to the system.</p>
                                    <a asp-controller="User" asp-action="AddEdit" class="premium-btn-primary">
                                        <i class="bi bi-person-plus me-2"></i>Create Your First User
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Premium Pagination -->
        <div class="premium-pagination-wrapper">
            <div class="premium-pagination-info" id="paginationInfo">
                Showing <strong id="showingStart">1</strong> to <strong id="showingEnd">10</strong> of <strong id="totalEntries">0</strong> entries
            </div>
            <nav class="premium-pagination">
                <ul class="premium-pagination-list" id="pagination">
                    <!-- Pagination will be generated by JavaScript -->
                </ul>
            </nav>
            <div class="premium-pagination-size">
                <select id="itemsPerPage" class="form-select form-select-sm" style="width: auto;">
                    <option value="5">5 per page</option>
                    <option value="10" selected>10 per page</option>
                    <option value="15">15 per page</option>
                    <option value="20">20 per page</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Premium Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title">
                    <i class="bi bi-trash text-danger me-2 fs-4"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body text-center px-4">
                <i class="bi bi-exclamation-triangle text-danger display-1"></i>
                <h6 class="mt-3 fw-bold">Are you absolutely sure?</h6>
                <p class="text-muted">
                    This action cannot be undone. This will permanently delete the user
                    <strong id="deleteUserName"></strong> and remove all associated data.
                </p>
            </div>

            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" class="btn btn-danger px-4">
                    <i class="bi bi-trash me-1"></i>Delete User
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Premium Message Modal -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title">
                    <i class="bi bi-envelope text-primary me-2 fs-4"></i>Send Message
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body px-4">
                <form id="messageForm">
                    <div class="mb-3">
                        <label for="messageSubject" class="form-label">Subject</label>
                        <input type="text" class="form-control" id="messageSubject" placeholder="Enter message subject">
                    </div>
                    <div class="mb-3">
                        <label for="messageContent" class="form-label">Message</label>
                        <textarea class="form-control" id="messageContent" rows="4" placeholder="Enter your message"></textarea>
                    </div>
                    <input type="hidden" id="messageUserId">
                    <input type="hidden" id="messageUserEmail">
                </form>
            </div>

            <div class="modal-footer border-top-0 justify-content-center pb-4">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="sendUserMessage()">
                    <i class="bi bi-send me-1"></i>Send Message
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Color Palette */
    :root {
        --premium-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --premium-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --premium-success: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --premium-warning: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
        --premium-danger: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
        --premium-info: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        --premium-dark: #1a1a2e;
        --premium-light: #ffffff;
        --premium-gray-100: #f8f9fa;
        --premium-gray-200: #e9ecef;
        --premium-gray-300: #dee2e6;
        --premium-gray-400: #ced4da;
        --premium-gray-500: #adb5bd;
        --premium-gray-600: #6c757d;
        --premium-gray-700: #495057;
        --premium-gray-800: #343a40;
        --premium-gray-900: #212529;
        --premium-shadow-sm: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        --premium-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        --premium-shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
        --premium-shadow-xl: 0 2rem 4rem rgba(0, 0, 0, 0.2);
        --premium-border-radius: 12px;
        --premium-border-radius-lg: 16px;
        --premium-border-radius-xl: 20px;
        --premium-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --premium-transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Premium Header */
    .premium-header-card {
        position: relative;
        background: var(--premium-light);
        border-radius: var(--premium-border-radius-xl);
        box-shadow: var(--premium-shadow-lg);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .premium-header-bg {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--premium-primary);
        opacity: 0.95;
    }

    .premium-header-content {
        position: relative;
        z-index: 2;
        padding: 3rem 2rem;
        color: var(--premium-light);
    }

    .premium-icon-wrapper {
        position: relative;
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: var(--premium-border-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .premium-icon-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        right: -50%;
        bottom: -50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, transparent 70%);
        animation: premium-glow 3s ease-in-out infinite alternate;
    }

    .premium-title {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #ffffff, #f0f0f0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .premium-subtitle {
        font-size: 1.25rem;
        opacity: 0.9;
